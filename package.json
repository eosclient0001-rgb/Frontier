{
  "name": "frontier-terrain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontier — Terrain. A WebGPU procedural terrain generator and texture authoring surface.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:symbols": "node scripts/check-wgsl-symbols.mjs",
    "check:engine": "node scripts/smoke.mjs",
    "check": "npm run check:wgsl && npm run check:symbols && npm run check:engine",
    "check:wgsl": "node scripts/check-wgsl.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "wgsl_reflect": "^1.6.0"
  }
}
