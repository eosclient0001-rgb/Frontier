+#!/usr/bin/env python3
+"""Check or apply the cloud integration to an existing Frontier-1 checkout."""
+
+import argparse
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[1]
+PATCH = ROOT / "patches/Frontier1CloudIntegration.patch"
+SHADER = "Engine/Shaders/Atmosphere/"
+MODULES = (
+    SHADER + "CloudAerialPerspective.slang",
+    SHADER + "CloudWeatherField.slang",
+    SHADER + "PlanetaryCloudTransport.slang",
+    "Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h",
+)
+
+
+def integration_patch():
+    # Generate addition hunks from the same modules the proof renderer builds.
+    # Keeping a second copy in the integration patch would let the two diverge.
+    patch = PATCH.read_bytes()
+    for path in MODULES:
+        data = (ROOT / path).read_bytes()
+        lines = data.splitlines(keepends=True)
+        header = f"diff --git a/{path} b/{path}\nnew file mode 100644\n--- /dev/null\n+++ b/{path}\n@@ -0,0 +1,{len(lines)} @@\n"
+        patch += header.encode() + b"".join(b"+" + line for line in lines)
+    return patch
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("checkout", type=Path, help="root of Frontier-1 (reference revision 8d75f4a)")
+    parser.add_argument("--check", action="store_true", help="verify patch applicability without writing files")
+    args = parser.parse_args()
+    checkout = args.checkout.resolve()
+    if not (checkout / "Engine/Shaders/Atmosphere/VolumetricCloudCompute.slang").is_file():
+        parser.error("checkout must point to the root of Frontier-1")
+    patch = integration_patch()
+    command = ["git", "apply", "--whitespace=error"]
+    subprocess.run(command + ["--check", "-"], cwd=checkout, input=patch, check=True)
+    if not args.check:
+        subprocess.run(command + ["-"], cwd=checkout, input=patch, check=True)
+    print("Cloud integration patch " + ("applies cleanly" if args.check else "applied"))
+
+
+if __name__ == "__main__":
+    main()
