+/*==========================================================================================================================================
+                                                             BAKECLOUDNOISE.CPP
+==========================================================================================================================================*/
+// 🧩 Write the native engine’s packed cloud volume for the offscreen exhibit.
+
+#include "Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h"
+
+#include <fstream>
+
+int main(int Count, char** Args)
+{
+    if (Count != 2) return 2;
+    const auto& Texels = Frontier::GeometricRaster::CloudNoiseVolume::QueryTexels();
+    std::ofstream File(Args[1], std::ios::binary);
+    File.write(reinterpret_cast<const char*>(Texels.data()), static_cast<std::streamsize>(Texels.size() * sizeof(uint32_t)));
+    return File ? 0 : 1;
+}
