+/*==========================================================================================================================================
+                                                             CLOUDPROOFHOST.CPP
+==========================================================================================================================================*/
+// 🧩 Run Slang’s native compute target over offscreen image tiles.
+
+// Dispatch the Slang CPU target without a window or a second implementation
+// of the cloud shader. The generated TU supplies the reflected ABI structs.
+#include "CloudProofGenerated.cpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+static_assert(sizeof(CloudProofInputs_0) == 176);
+
+extern "C" void RenderCloudTile(const void* UniformBytes, uint32_t* Noise, size_t NoiseCount,
+                                uint32_t* Surface, size_t SurfaceCount, uint32_t* Pixels,
+                                uint32_t WorkerCount)
+{
+    CloudProofInputs_0 Inputs;
+    std::memcpy(&Inputs, UniformBytes, sizeof(Inputs));
+    const uint32_t W = Inputs.Size_0.x, H = Inputs.Tile_0.y;
+    GlobalParams_0 Bindings {};
+    Bindings.PlanetaryCloudNoise_0 = {Noise, NoiseCount};
+    Bindings.Inputs_0 = &Inputs;
+    Bindings.ProofPixels_0 = {Pixels, size_t(W) * H};
+    Bindings.PlanetSurface_0 = {Surface, SurfaceCount};
+    const uint32_t GroupsY = (H + 7) / 8;
+    const uint32_t GroupsX = (W + 7) / 8;
+    std::atomic<uint32_t> Row {0};
+    auto Render = [&]
+    {
+        for (uint32_t Y; (Y = Row.fetch_add(1, std::memory_order_relaxed)) < GroupsY;)
+        {
+            ComputeVaryingInput Range {{0, Y, 0}, {GroupsX, Y + 1, 1}};
+            CloudProofEntry(&Range, nullptr, &Bindings);
+        }
+    };
+    std::vector<std::jthread> Threads;
+    for (uint32_t I = 1; I < std::min(WorkerCount, GroupsY); ++I)
+        Threads.emplace_back(Render);
+    Render();
+}
