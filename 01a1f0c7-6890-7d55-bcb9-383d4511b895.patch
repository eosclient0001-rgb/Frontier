@@ -0,0 +1,83 @@
+/*==========================================================================================================================================
+                                                        CLOUDAERIALPERSPECTIVE.SLANG
+==========================================================================================================================================*/
+// 🧩 Aerial scattering in front of premultiplied cloud radiance.
+
+#ifndef FRONTIER_CLOUD_AERIAL_PERSPECTIVE
+#define FRONTIER_CLOUD_AERIAL_PERSPECTIVE 1
+
+#include "PlanetaryCloudTransport.slang"
+
+struct CloudAirSegment
+{
+    float3 Radiance;
+    float3 Transmittance;
+};
+
+CloudAirSegment IntegrateCloudAir(PlanetaryCloudConfig C, float3 O, float3 D, float MaxM,
+                                  uint Steps, bool CloudShafts)
+{
+    CloudAirSegment Out;
+    Out.Radiance = float3(0.0);
+    Out.Transmittance = float3(1.0);
+    float2 Atmosphere = PlanetCloudSphere(O, D, C.RadiusM + 100000.0);
+    float Enter = max(0.0, Atmosphere.x);
+    float Exit = min(MaxM, Atmosphere.y);
+    if (Exit <= Enter) return Out;
+
+    float CosTheta = dot(D, C.SunDirection);
+    float PhaseR = (3.0 / (16.0 * CloudTransportPi)) * (1.0 + CosTheta * CosTheta);
+    float PhaseM = CloudTransportHG(CosTheta, 0.78);
+    float3 BetaR = PlanetCloudAirBetaRay(C);
+    float3 BetaM = PlanetCloudAirBetaMie(C);
+    float3 BetaO = C.AtmosphereStrengths.z * float3(0.650e-6, 1.881e-6, 0.085e-6);
+
+    // Split at closest approach. Cubic spacing spends samples near the dense
+    // atmosphere whether the ray starts on the ground or comes in from orbit.
+    float Closest = clamp(-dot(O, D), Enter, Exit);
+    for (uint Side = 0u; Side < 2u; ++Side)
+    {
+        float SideLen = (Side == 0u) ? Closest - Enter : Exit - Closest;
+        if (SideLen < 0.1) continue;
+        float Last = (Side == 0u) ? Enter : Closest;
+        for (uint I = 0u; I < Steps; ++I)
+        {
+            float F = float(I + 1u) / float(Steps);
+            float U = (Side == 0u) ? 1.0 - F : F;
+            float T = Closest + SideLen * (0.30 * U + 0.70 * U * U * U) * ((Side == 0u) ? -1.0 : 1.0);
+            float Dt = T - Last;
+            float SampleT = (T + Last) * 0.5;
+            Last = T;
+            float3 P = O + D * SampleT;
+            float Alt = max(0.0, PlanetCloudAltitude(P, C.RadiusM));
+            float3 Ray = BetaR * exp(-Alt / max(400.0, C.AirScaleHeightsM.x));
+            float3 Mie = BetaM * exp(-Alt / max(200.0, C.AirScaleHeightsM.y));
+            float3 Ozone = BetaO * saturate(1.0 - abs(Alt - 25000.0) / 16000.0);
+            float3 Ext = max(float3(1.0e-8), Ray + Mie + Ozone);
+            float3 SegT = exp(-Ext * Dt);
+            float3 SunT = CloudSolarAirTransmittance(C, P);
+            float SunUp = dot(normalize(P), C.SunDirection);
+            float Twilight = smoothstep(-0.21, 0.095, SunUp + Alt * 0.000002);
+            float Visibility = 1.0;
+            if (CloudShafts && CosTheta > 0.69 && Alt < 4300.0 && SampleT < 65000.0 && dot(SunT, SunT) > 0.0005)
+                Visibility = exp(-CloudSolarOpticalDepth(C, P, 4u));
+            float3 Source = SunT * Visibility * (Ray * PhaseR + 0.88 * Mie * PhaseM);
+            Source += (Ray + 0.48 * Mie) * Twilight * float3(0.019, 0.025, 0.034);
+            Out.Radiance += Out.Transmittance * C.SolarIrradiance * Source * (1.0 - SegT) / Ext;
+            Out.Transmittance *= SegT;
+        }
+    }
+    return Out;
+}
+
+// Cloud result is premultiplied. Reinsert the air in front of the cloud which
+// would otherwise be incorrectly darkened with the background. The weighted
+// optical centroid is an approximation for multiple separated opaque layers.
+float3 CloudRadianceThroughAir(PlanetaryCloudConfig C, float3 O, float3 D, PlanetaryCloudResult Cloud, uint AirSteps)
+{
+    if (Cloud.Transmittance >= 0.999999) return Cloud.Radiance;
+    CloudAirSegment Front = IntegrateCloudAir(C, O, D, Cloud.DistanceM, AirSteps, false);
+    return Front.Transmittance * Cloud.Radiance + (1.0 - Cloud.Transmittance) * Front.Radiance;
+}
+
+#endif
