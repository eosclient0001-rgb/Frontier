+#!/usr/bin/env python3
+"""Render the production Slang cloud medium offscreen on a host or Vulkan device."""
+
+import argparse
+from contextlib import ExitStack
+import ctypes as ct
+from dataclasses import dataclass, replace
+from hashlib import sha256
+import math
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+from tempfile import TemporaryDirectory
+import time
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+PROOF = ROOT / "Exhibits/CloudProof"
+CACHE = ROOT / ".cache/cloud-proof"
+ENTRY = "CloudProofEntry"
+EARTH_SHA256 = "cd7712d3e891425d9948ea5ac18d3bb1e7e834ea038188587897e689a7b35d0f"
+
+
+@dataclass(frozen=True)
+class Scene:
+    name: str
+    origin: tuple
+    view: tuple
+    sun: tuple
+    fov: float
+    coverage: float
+    extinction: float
+    seed: float
+    exposure: float
+    floor: float = 930.0
+    depth: float = 2790.0
+    scale: float = 0.46
+    phase: float = 0.84
+    mode: int = 0
+    shafts: int = 0
+    air: tuple = (1.0, 1.0, 1.0)
+    meridian: float = 0.0
+    solar: float = 16.0
+    wind: tuple = (0.0, 0.0)
+
+
+SCENES = {
+    "ground": Scene("01-ocean-cumulus", (-3000, 4200, 23), (-42, 9.5), (-114, 21), 33, 0.34, 1.03, 0.04, 1.05, floor=1110, depth=3550, air=(0.94, 0.78, 1.0)),
+    "gap": Scene("02-silver-lining", (-2480, 2550, 1120), (-25, 18), (-17, 25), 26, 0.31, 0.93, 0.04, 0.74, depth=4720, phase=0.81),
+    "sunset": Scene("03-golden-hour", (-1200, -500, 23), (25, 10), (14, 4.2), 37, 0.35, 0.82, 0.80, 1.22, depth=3770, shafts=0),
+    "dawn": Scene("04-dawn", (-3500, 3250, 61), (-11, 10.2), (-23, -1.78), 34, 0.36, 0.91, 2.1, 2.68, depth=4020),
+    "orbit": Scene("05-orbital-limb", (-210000, -190000, 610000), (17, -36), (-59, 39), 44, 0.52, 1.15, 0.04, 0.94, mode=1, meridian=-0.025, air=(0.85, 0.72, 0.9)),
+    "moon": Scene("06-lunar-vacuum", (0, 0, 18), (2, 13), (0, 21), 32, 1.0, 4.0, 0.04, 1.0, mode=2),
+}
+
+
+def direction(az, el):
+    az, el = math.radians(az), math.radians(el)
+    return math.cos(el) * math.cos(az), math.cos(el) * math.sin(az), math.sin(el)
+
+
+def cross(a, b):
+    return (a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0])
+
+
+def uniform_bytes(scene, width, height, surface, row, rows, steps, light_steps, samples, transmittance):
+    forward = direction(*scene.view)
+    az = math.radians(scene.view[0])
+    right = (math.sin(az), -math.cos(az), 0.0)
+    up = cross(right, forward)
+    tan_y = math.tan(math.radians(scene.fov) / 2)
+    return struct.pack(
+        "<32f12I",
+        *scene.origin, scene.wind[0], *forward, scene.wind[1],
+        *right, tan_y * width / height, *up, tan_y,
+        *direction(*scene.sun), scene.solar,
+        scene.floor, scene.depth, scene.coverage, scene.extinction,
+        scene.scale, scene.seed, scene.phase, scene.exposure,
+        *scene.air, scene.meridian,
+        scene.mode, steps, light_steps, scene.shafts,
+        width, height, *surface,
+        row, rows, samples, int(transmittance),
+    )
+
+
+class VulkanRenderer:
+    def __init__(self, resources, shader, noise, surface, tile_bytes):
+        self.resources = resources
+        self.instance = vk.vkCreateInstance(vk.VkInstanceCreateInfo(
+            pApplicationInfo=vk.VkApplicationInfo(apiVersion=vk.VK_MAKE_VERSION(1, 1, 0))), None)
+        resources.callback(vk.vkDestroyInstance, self.instance, None)
+        devices = vk.vkEnumeratePhysicalDevices(self.instance)
+        physical, family = next((device, index) for device in devices
+                                for index, queue in enumerate(vk.vkGetPhysicalDeviceQueueFamilyProperties(device))
+                                if queue.queueCount and queue.queueFlags & vk.VK_QUEUE_COMPUTE_BIT)
+        name = vk.vkGetPhysicalDeviceProperties(physical).deviceName
+        print(f"Device: {name}", flush=True)
+        self.memory = vk.vkGetPhysicalDeviceMemoryProperties(physical)
+        self.device = device = vk.vkCreateDevice(physical, vk.VkDeviceCreateInfo(pQueueCreateInfos=[
+            vk.VkDeviceQueueCreateInfo(queueFamilyIndex=family, pQueuePriorities=[1.0])]), None)
+        resources.callback(vk.vkDestroyDevice, device, None)
+        self.queue = vk.vkGetDeviceQueue(device, family, 0)
+        storage = vk.VK_DESCRIPTOR_TYPE_STORAGE_BUFFER
+        types = [vk.VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, storage, storage, storage]
+        layout = vk.vkCreateDescriptorSetLayout(device, vk.VkDescriptorSetLayoutCreateInfo(pBindings=[
+            vk.VkDescriptorSetLayoutBinding(binding=i, descriptorType=t, descriptorCount=1, stageFlags=vk.VK_SHADER_STAGE_COMPUTE_BIT)
+            for i, t in enumerate(types)]), None)
+        resources.callback(vk.vkDestroyDescriptorSetLayout, device, layout, None)
+        self.pipeline_layout = vk.vkCreatePipelineLayout(device, vk.VkPipelineLayoutCreateInfo(pSetLayouts=[layout]), None)
+        resources.callback(vk.vkDestroyPipelineLayout, device, self.pipeline_layout, None)
+        module = vk.vkCreateShaderModule(device, vk.VkShaderModuleCreateInfo(codeSize=len(shader), pCode=shader), None)
+        resources.callback(vk.vkDestroyShaderModule, device, module, None)
+        stage = vk.VkPipelineShaderStageCreateInfo(stage=vk.VK_SHADER_STAGE_COMPUTE_BIT, module=module, pName=ENTRY)
+        self.pipeline = vk.vkCreateComputePipelines(device, vk.VK_NULL_HANDLE, 1, [
+            vk.VkComputePipelineCreateInfo(stage=stage, layout=self.pipeline_layout)], None)[0]
+        resources.callback(vk.vkDestroyPipeline, device, self.pipeline, None)
+        uniform_buf, self.uniform = self.buffer(176, vk.VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT)
+        noise_buf, noise_map = self.buffer(len(noise), vk.VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)
+        out_buf, self.output = self.buffer(tile_bytes, vk.VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)
+        surface_buf, surface_map = self.buffer(len(surface), vk.VK_BUFFER_USAGE_STORAGE_BUFFER_BIT)
+        noise_map[:] = noise
+        surface_map[:] = surface
+        pool = vk.vkCreateDescriptorPool(device, vk.VkDescriptorPoolCreateInfo(maxSets=1, pPoolSizes=[
+            vk.VkDescriptorPoolSize(type=types[0], descriptorCount=1),
+            vk.VkDescriptorPoolSize(type=storage, descriptorCount=3)]), None)
+        resources.callback(vk.vkDestroyDescriptorPool, device, pool, None)
+        self.set = vk.vkAllocateDescriptorSets(device, vk.VkDescriptorSetAllocateInfo(descriptorPool=pool, pSetLayouts=[layout]))[0]
+        writes = []
+        for i, (ty, buf, n) in enumerate(zip(types, (uniform_buf, noise_buf, out_buf, surface_buf), (176, len(noise), tile_bytes, len(surface)))):
+            writes.append(vk.VkWriteDescriptorSet(dstSet=self.set, dstBinding=i, descriptorCount=1, descriptorType=ty,
+                                               pBufferInfo=[vk.VkDescriptorBufferInfo(buffer=buf, offset=0, range=n)]))
+        vk.vkUpdateDescriptorSets(device, len(writes), writes, 0, None)
+        self.command_pool = vk.vkCreateCommandPool(device, vk.VkCommandPoolCreateInfo(queueFamilyIndex=family), None)
+        resources.callback(vk.vkDestroyCommandPool, device, self.command_pool, None)
+        self.command = vk.vkAllocateCommandBuffers(device, vk.VkCommandBufferAllocateInfo(
+            commandPool=self.command_pool, level=vk.VK_COMMAND_BUFFER_LEVEL_PRIMARY, commandBufferCount=1))[0]
+
+    def buffer(self, size, usage):
+        device = self.device
+        buf = vk.vkCreateBuffer(device, vk.VkBufferCreateInfo(size=size, usage=usage, sharingMode=vk.VK_SHARING_MODE_EXCLUSIVE), None)
+        try:
+            req = vk.vkGetBufferMemoryRequirements(device, buf)
+            flags = vk.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
+            index = next(i for i in range(self.memory.memoryTypeCount) if (req.memoryTypeBits >> i) & 1
+                         and self.memory.memoryTypes[i].propertyFlags & flags == flags)
+            mem = vk.vkAllocateMemory(device, vk.VkMemoryAllocateInfo(allocationSize=req.size, memoryTypeIndex=index), None)
+        except BaseException:
+            vk.vkDestroyBuffer(device, buf, None)
+            raise
+        self.resources.callback(vk.vkFreeMemory, device, mem, None)
+        self.resources.callback(vk.vkDestroyBuffer, device, buf, None)
+        vk.vkBindBufferMemory(device, buf, mem, 0)
+        mapped = vk.vkMapMemory(device, mem, 0, size, 0)
+        self.resources.callback(vk.vkUnmapMemory, device, mem)
+        return buf, mapped
+
+    def dispatch(self, uniform, width, rows):
+        self.uniform[:] = uniform
+        vk.vkResetCommandPool(self.device, self.command_pool, 0)
+        cmd = self.command
+        vk.vkBeginCommandBuffer(cmd, vk.VkCommandBufferBeginInfo(flags=vk.VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT))
+        vk.vkCmdBindPipeline(cmd, vk.VK_PIPELINE_BIND_POINT_COMPUTE, self.pipeline)
+        vk.vkCmdBindDescriptorSets(cmd, vk.VK_PIPELINE_BIND_POINT_COMPUTE, self.pipeline_layout, 0, 1, [self.set], 0, None)
+        vk.vkCmdDispatch(cmd, (width + 7) // 8, (rows + 7) // 8, 1)
+        barrier = vk.VkMemoryBarrier(srcAccessMask=vk.VK_ACCESS_SHADER_WRITE_BIT, dstAccessMask=vk.VK_ACCESS_HOST_READ_BIT)
+        vk.vkCmdPipelineBarrier(cmd, vk.VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.VK_PIPELINE_STAGE_HOST_BIT,
+                                0, 1, [barrier], 0, None, 0, None)
+        vk.vkEndCommandBuffer(cmd)
+        vk.vkQueueSubmit(self.queue, 1, [vk.VkSubmitInfo(pCommandBuffers=[cmd])], vk.VK_NULL_HANDLE)
+        vk.vkQueueWaitIdle(self.queue)
+        return self.output[:width * rows * 4]
+
+
+class HostRenderer:
+    def __init__(self, library, noise, surface, tile_bytes, workers):
+        self.library = ct.CDLL(str(library))
+        self.render = self.library.RenderCloudTile
+        self.render.restype = None
+        self.render.argtypes = [ct.c_void_p, ct.c_void_p, ct.c_size_t, ct.c_void_p, ct.c_size_t, ct.c_void_p, ct.c_uint32]
+        self.noise = ct.create_string_buffer(noise, len(noise))
+        self.surface = ct.create_string_buffer(surface, len(surface))
+        self.output = ct.create_string_buffer(tile_bytes)
+        self.workers = workers
+        print("Device: native Slang C++ target", flush=True)
+
+    def dispatch(self, uniform, width, rows):
+        self.render(uniform, self.noise, len(self.noise) // 4, self.surface, len(self.surface) // 4, self.output, self.workers)
+        return self.output.raw[:width * rows * 4]
+
+
+def bake(slangc, backend):
+    CACHE.mkdir(parents=True, exist_ok=True)
+    source = PROOF / "CloudProofCompute.slang"
+    shader_sources = sorted((ROOT / "Engine/Shaders/Atmosphere").glob("*.slang"))
+    shader_sources.extend((source, PROOF / "CloudProofHost.cpp"))
+    key = sha256(b"".join(p.read_bytes() for p in shader_sources)).hexdigest()[:16]
+    build = CACHE / key
+    build.mkdir(exist_ok=True)
+    compiler = [slangc, str(source), "-entry", ENTRY, "-O0"]
+    cxx = os.environ.get("CXX", "c++")
+    with TemporaryDirectory(dir=build) as scratch:
+        # Publish by rename. Concurrent captures may have an older shared
+        # object mapped, or build the same revision in parallel.
+        work = Path(scratch)
+        if backend == "vulkan":
+            spv = work / "CloudProofCompute.spv"
+            subprocess.run(compiler + ["-target", "spirv", "-profile", "spirv_1_3",
+                                        "-fvk-use-entrypoint-name", "-o", str(spv)], check=True)
+            shader = spv.read_bytes()
+            spv.replace(build / spv.name)
+        else:
+            cpp = work / "CloudProofGenerated.cpp"
+            library = work / "CloudProofHost.so"
+            subprocess.run(compiler + ["-target", "cpp", "-o", str(cpp)], check=True)
+            subprocess.run([cxx, "-std=c++20", "-O3", "-fno-math-errno", "-march=native", "-pthread", "-shared", "-fPIC",
+                            "-I", str(work), str(PROOF / "CloudProofHost.cpp"), "-o", str(library)], check=True)
+            shader = library.replace(build / library.name)
+    baker_src = PROOF / "BakeCloudNoise.cpp"
+    noise_src = ROOT / "Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h"
+    fingerprint = sha256(baker_src.read_bytes() + noise_src.read_bytes()).hexdigest()[:16]
+    noise = CACHE / (fingerprint + ".volume")
+    if not noise.exists():
+        with TemporaryDirectory(dir=CACHE) as scratch:
+            baker = Path(scratch) / "BakeCloudNoise"
+            subprocess.run([cxx, "-std=c++20", "-O3", "-I", str(ROOT),
+                            str(baker_src), "-o", str(baker)], check=True)
+            volume = Path(scratch) / "cloud.volume"
+            subprocess.run([str(baker), str(volume)], check=True)
+            volume.replace(noise)
+    return shader, noise.read_bytes()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("scenes", nargs="*", metavar="SCENE", help=", ".join(SCENES))
+    parser.add_argument("--backend", choices=("host", "vulkan"), default="host")
+    parser.add_argument("--workers", type=int, default=min(8, os.cpu_count() or 1))
+    parser.add_argument("--slangc", default=os.environ.get("SLANGC", "slangc"))
+    parser.add_argument("--earth", type=Path, help="the pinned, cloud-free Solar System Scope day map (see README)")
+    parser.add_argument("--width", type=int, default=1920)
+    parser.add_argument("--height", type=int, default=1080)
+    parser.add_argument("--steps", type=int, default=144)
+    parser.add_argument("--light-steps", type=int, default=5)
+    parser.add_argument("--samples", type=int, default=1)
+    parser.add_argument("--out", type=Path, default=ROOT / "output")
+    parser.add_argument("--transmittance", action="store_true")
+    parser.add_argument("--coverage", type=float)
+    args = parser.parse_args()
+    names = args.scenes or ["ground", "gap", "sunset", "dawn", "orbit"]
+    if unknown := set(names) - SCENES.keys():
+        parser.error(f"unknown scenes: {', '.join(sorted(unknown))}")
+    if min(args.width, args.height, args.steps, args.light_steps, args.samples, args.workers) < 1:
+        parser.error("dimensions and sample counts must be positive")
+    if args.coverage is not None and not 0.0 <= args.coverage <= 1.0:
+        parser.error("coverage must be in [0, 1]")
+    if "orbit" in names and args.earth is None:
+        parser.error("orbit needs --earth; see the README for the exact asset")
+    args.out.mkdir(parents=True, exist_ok=True)
+    if args.earth:
+        if sha256(args.earth.read_bytes()).hexdigest() != EARTH_SHA256:
+            parser.error("Earth day map SHA-256 did not match")
+        with Image.open(args.earth) as source:
+            surface = source.convert("RGBA")
+    else:
+        surface = Image.new("RGBA", (1, 1))
+    if args.backend == "vulkan":
+        global vk
+        import vulkan as vk
+    shader, noise = bake(args.slangc, args.backend)
+    tile_rows = min(64, args.height)
+    with ExitStack() as resources:
+        tile_bytes = args.width * tile_rows * 4
+        if args.backend == "vulkan":
+            renderer = VulkanRenderer(resources, shader, noise, surface.tobytes(), tile_bytes)
+        else:
+            renderer = HostRenderer(shader, noise, surface.tobytes(), tile_bytes, args.workers)
+        for name in names:
+            scene = SCENES[name]
+            if args.coverage is not None:
+                scene = replace(scene, coverage=args.coverage)
+            started = time.monotonic()
+            rgba = bytearray()
+            for y in range(0, args.height, tile_rows):
+                rows = min(tile_rows, args.height - y)
+                uniform = uniform_bytes(scene, args.width, args.height, surface.size, y, rows, args.steps,
+                                        args.light_steps, args.samples, args.transmittance)
+                rgba.extend(renderer.dispatch(uniform, args.width, rows))
+            frame = Image.frombytes("RGBA", (args.width, args.height), bytes(rgba)).convert("RGB")
+            suffix = "-transmittance" if args.transmittance else ""
+            dest = args.out / (scene.name + suffix + ".png")
+            with TemporaryDirectory(dir=args.out) as scratch:
+                temp = Path(scratch) / dest.name
+                frame.save(temp)
+                temp.replace(dest)
+            print(f"{dest}: {frame.width}x{frame.height} in {time.monotonic() - started:.1f}s", flush=True)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
