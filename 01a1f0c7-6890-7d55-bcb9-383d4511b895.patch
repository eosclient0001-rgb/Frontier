@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Numerical invariants and a deterministic motion smoke test for the Slang cloud path."""
+
+import argparse
+from contextlib import ExitStack
+from dataclasses import replace
+from pathlib import Path
+import os
+import struct
+import subprocess
+import tempfile
+
+import RenderCloudProof as proof
+from ApplyFrontierCloudPatch import MODULES
+
+
+CASES = (
+    "upward ray enters the low shell",
+    "camera inside a shell exits without a discarded near interval",
+    "downward orbital ray is clipped against the planet",
+    "grazing ray sees one connected shell interval",
+    "high ice remains sunlit with low cloud in planetary shadow",
+    "vacuum bypasses cloud radiance and shadows regardless of coverage",
+    "dual-lobe HG integrates to unit spherical energy",
+    "water, mid and ice shells have ordered non-overlapping bounds",
+    "weather-front rotation preserves radius and is invertible",
+)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--slangc", default=os.environ.get("SLANGC", "slangc"))
+    p.add_argument("--vulkan-diagnostics", action="store_true", help="also exercise transport math and volume bindings on Vulkan")
+    p.add_argument("--frontier-checkout", type=Path, help="also exercise the patched viewport cloud entry on the host")
+    args = p.parse_args()
+    # Do not overwrite a running beauty render's build cache.
+    with tempfile.TemporaryDirectory(prefix="cloud-proof-test-") as temp:
+        proof.CACHE = Path(temp)
+        library, noise = proof.bake(args.slangc, "host")
+        run(library, noise)
+        if args.vulkan_diagnostics:
+            run_vulkan(args.slangc, noise, Path(temp))
+        if args.frontier_checkout:
+            run_viewport(args.slangc, args.frontier_checkout.resolve(), Path(temp))
+
+
+def run(library, noise):
+    volume_words = 128**3 + 64**3
+    assert len(noise) == (volume_words + 64**2) * 4, "packed 3D volume layout changed"
+    assert set(struct.unpack_from("<4096I", noise, volume_words * 4)) == set(range(4096)), "blue ranks are not a permutation"
+    w, h = 80, 45
+    renderer = proof.HostRenderer(library, noise, b"\0" * 4, w * h * 4, 2)
+
+    def draw(scene, width=w, height=h, mode=1):
+        uniform = proof.uniform_bytes(scene, width, height, (1, 1), 0, height, 80, 4, 1, mode)
+        return renderer.dispatch(uniform, width, height)
+
+    scene = proof.SCENES["ground"]
+    pixels = draw(scene, len(CASES), 1, 2)
+    for i, case in enumerate(CASES):
+        assert pixels[i * 4 : i * 4 + 4] == b"\x00\xff\x00\xff", case
+        print(f"PASS: {case}")
+    vacuum = draw(proof.SCENES["moon"])
+    assert vacuum == b"\xff" * len(vacuum), "Moon transmittance not exactly clear"
+    empty = draw(replace(scene, coverage=0.0))
+    assert empty == b"\xff" * len(empty), "zero coverage did not bypass global cloud transport"
+    a = draw(scene)
+    moved = draw(replace(scene, wind=(610.0, -340.0)))
+    b = draw(scene)
+    assert min(a[::4]) < 230 and max(a[::4]) == 255, "ground proof missing cloud or clearing"
+    assert sum(abs(x - y) for x, y in zip(a[::4], moved[::4])) / (w * h) > 1.0, "wind did not advect cloud density"
+    assert a == b, "drawing a displaced frame affected the next frame"
+    print("PASS: lunar vacuum, zero coverage, wind displacement, stateless frame replay")
+
+
+def run_vulkan(slangc, noise, temp):
+    import vulkan
+
+    proof.vk = vulkan
+    spv = temp / "CloudDiagnostics.spv"
+    subprocess.run([slangc, str(proof.PROOF / "CloudProofCompute.slang"), "-entry", proof.ENTRY,
+                    "-target", "spirv", "-profile", "spirv_1_3", "-fvk-use-entrypoint-name", "-O0",
+                    "-D", "FRONTIER_CLOUD_GPU_DIAGNOSTICS=1", "-o", str(spv)], check=True)
+    cases = list(CASES)
+    cases[5] = "base, erosion and blue-noise bindings contain distinct, addressable samples"
+    with ExitStack() as resources:
+        width = len(cases)
+        renderer = proof.VulkanRenderer(resources, spv.read_bytes(), noise, b"\0" * 4, width * 4)
+        uniform = proof.uniform_bytes(proof.SCENES["ground"], width, 1, (1, 1), 0, 1, 80, 4, 1, 2)
+        pixels = renderer.dispatch(uniform, width, 1)
+        for i, case in enumerate(cases):
+            assert pixels[i * 4 : i * 4 + 4] == b"\x00\xff\x00\xff", case
+            print(f"PASS (Vulkan diagnostic): {case}")
+
+
+def run_viewport(slangc, checkout, temp):
+    for path in MODULES:
+        target = checkout / path
+        if not target.is_file() or target.read_bytes() != (proof.ROOT / path).read_bytes():
+            raise SystemExit(f"{target}: apply this revision of the Frontier-1 cloud patch first")
+    source = checkout / "Engine/Shaders/GeometricRaster/WorldViewportRadiometricCompute.slang"
+    generated = temp / "ViewportCloudGenerated.cpp"
+    executable = temp / "ViewportCloudSmoke"
+    subprocess.run([slangc, str(source), "-entry", "CloudComputeEntry", "-target", "cpp",
+                    "-matrix-layout-row-major", "-O0", "-o", str(generated)], check=True)
+    subprocess.run([os.environ.get("CXX", "c++"), "-std=c++20", "-O3", "-fno-math-errno",
+                    "-I", str(temp), "-I", str(checkout), str(proof.PROOF / "ViewportCloudSmoke.cpp"),
+                    "-o", str(executable)], check=True)
+    subprocess.run([str(executable)], check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h b/Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h
new file mode 100644
index 0000000..ee8d7dc
--- /dev/null
+++ b/Engine/GeometricRaster/Atmosphere/CloudNoiseVolume.h
@@ -0,0 +1,214 @@
+/*==========================================================================================================================================
+                                                             CLOUDNOISEVOLUME.H
+==========================================================================================================================================*/
+// 🧩 Deterministic packed Perlin–Worley shape, erosion, and void-and-cluster ranks.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace Frontier::GeometricRaster::CloudNoiseVolume
+{
+
+inline constexpr int BaseSize = 128;
+inline constexpr int DetailSize = 64;
+inline constexpr int BlueSize = 64;
+inline constexpr uint32_t BaseOffset = 0;
+inline constexpr uint32_t DetailOffset = BaseSize * BaseSize * BaseSize;
+inline constexpr uint32_t BlueOffset = DetailOffset + DetailSize * DetailSize * DetailSize;
+
+namespace Detail
+{
+
+struct Point { float X, Y, Z; };
+
+[[nodiscard]] inline uint32_t Mix(uint32_t V)
+{
+    V = (V ^ (V >> 16u)) * 0x7feb352du;
+    V = (V ^ (V >> 15u)) * 0x846ca68bu;
+    return V ^ (V >> 16u);
+}
+
+[[nodiscard]] inline float Unit(uint32_t V)
+{
+    return float(Mix(V) >> 8u) * (1.0f / 16777216.0f);
+}
+
+[[nodiscard]] inline float Fade(float T)
+{
+    return T * T * T * (T * (T * 6.0f - 15.0f) + 10.0f);
+}
+
+[[nodiscard]] inline std::size_t Index(int X, int Y, int Z, int Size)
+{
+    const int Mask = Size - 1;
+    return static_cast<std::size_t>(((Z & Mask) * Size + (Y & Mask)) * Size + (X & Mask));
+}
+
+// Periodicity is confined to local shape synthesis, never to the coverage field.
+class CellularLattice
+{
+public:
+    CellularLattice(int Cells, uint32_t Seed) : Size(Cells), Features(Cells * Cells * Cells)
+    {
+        for (std::size_t I = 0; I < Features.size(); ++I)
+        {
+            const uint32_t H = Mix(static_cast<uint32_t>(I) ^ Seed);
+            Features[I] = {Unit(H), Unit(H ^ 0x98f81357u), Unit(H ^ 0xda32b819u)};
+        }
+    }
+
+    [[nodiscard]] float Sample(Point Uv) const
+    {
+        const Point P {Uv.X * Size, Uv.Y * Size, Uv.Z * Size};
+        const int X = int(P.X), Y = int(P.Y), Z = int(P.Z);
+        const Point F {P.X - X, P.Y - Y, P.Z - Z};
+        // Jittered features in the enclosing 3^3 cells. The field is clamped at
+        // F1=1, so all cells beyond this neighborhood are out of support.
+        float D = 1.0f;
+        for (int K = -1; K <= 1; ++K)
+        for (int J = -1; J <= 1; ++J)
+        for (int I = -1; I <= 1; ++I)
+        {
+            const auto Q = Features[Index(X + I, Y + J, Z + K, Size)];
+            const float Dx = F.X - float(I) - Q.X;
+            const float Dy = F.Y - float(J) - Q.Y;
+            const float Dz = F.Z - float(K) - Q.Z;
+            D = std::min(D, Dx * Dx + Dy * Dy + Dz * Dz);
+        }
+        return 1.0f - std::sqrt(D);
+    }
+
+private:
+    int Size;
+    std::vector<Point> Features;
+};
+
+[[nodiscard]] inline float Perlin(Point Uv, int Cells, uint32_t Seed)
+{
+    const Point P {Uv.X * Cells, Uv.Y * Cells, Uv.Z * Cells};
+    const int X = int(P.X), Y = int(P.Y), Z = int(P.Z);
+    const float Fx = P.X - X, Fy = P.Y - Y, Fz = P.Z - Z;
+    const float U = Fade(Fx), V = Fade(Fy), W = Fade(Fz);
+    std::array<float, 8> Corners {};
+    for (int I = 0; I < 8; ++I)
+    {
+        const int A = I & 1, B = (I >> 1) & 1, C = (I >> 2) & 1;
+        const uint32_t H = Mix(static_cast<uint32_t>(Index(X + A, Y + B, Z + C, Cells)) ^ Seed);
+        const float Dx = Fx - A, Dy = Fy - B, Dz = Fz - C;
+        const float S = (H & 4u) ? Dx : Dy;
+        const float T = (H & 4u) ? ((H & 8u) ? Dy : Dz) : Dz;
+        Corners[I] = ((H & 1u) ? S : -S) + ((H & 2u) ? T : -T);
+    }
+    return std::lerp(std::lerp(std::lerp(Corners[0], Corners[1], U), std::lerp(Corners[2], Corners[3], U), V),
+                     std::lerp(std::lerp(Corners[4], Corners[5], U), std::lerp(Corners[6], Corners[7], U), V), W);
+}
+
+[[nodiscard]] inline uint32_t Unorm(float V)
+{
+    return static_cast<uint32_t>(std::clamp(V, 0.0f, 1.0f) * 255.0f + 0.5f);
+}
+
+// Void-and-cluster rank tile. Use a truncated toroidal Gaussian so only the
+// neighborhood of an inserted point needs its energy updated. No white/IGN fallback.
+inline void BuildBlueRanks(uint32_t* Ranks)
+{
+    constexpr int Count = BlueSize * BlueSize;
+    constexpr int Initial = Count / 10;
+    constexpr int Reach = 6;
+    std::array<bool, Count> Mask {};
+    std::array<float, Count> Energy {};
+    std::array<float, (2 * Reach + 1) * (2 * Reach + 1)> Kernel {};
+    for (int Y = -Reach; Y <= Reach; ++Y)
+    for (int X = -Reach; X <= Reach; ++X)
+        Kernel[(Y + Reach) * (2 * Reach + 1) + X + Reach] = std::exp(-float(X * X + Y * Y) / 4.5f);
+    auto Put = [&](int I, bool Active)
+    {
+        Mask[I] = Active;
+        const int X = I % BlueSize, Y = I / BlueSize;
+        const float Sign = Active ? 1.0f : -1.0f;
+        for (int J = -Reach; J <= Reach; ++J)
+        for (int K = -Reach; K <= Reach; ++K)
+            Energy[((Y + J) & (BlueSize - 1)) * BlueSize + ((X + K) & (BlueSize - 1))] +=
+                Sign * Kernel[(J + Reach) * (2 * Reach + 1) + K + Reach];
+    };
+    auto Find = [&](bool Active)
+    {
+        int Best = -1;
+        for (int I = 0; I < Count; ++I)
+            if (Mask[I] == Active && (Best < 0 || (Active ? Energy[I] > Energy[Best] : Energy[I] < Energy[Best])))
+                Best = I;
+        return Best;
+    };
+    for (int N = 0, I = 0; N < Initial; ++I)
+    {
+        const int J = int(Mix(uint32_t(I) ^ 0xb489de2fu) & (Count - 1));
+        if (!Mask[J]) { Put(J, true); ++N; }
+    }
+    for (int I = 0; I < Count * 2; ++I)
+    {
+        const int Cluster = Find(true);
+        Put(Cluster, false);
+        const int Void = Find(false);
+        Put(Void, true);
+        if (Void == Cluster) break;
+    }
+    const auto OptimizedMask = Mask;
+    const auto OptimizedEnergy = Energy;
+    for (int N = Initial - 1; N >= 0; --N)
+    {
+        const int I = Find(true);
+        Ranks[I] = uint32_t(N);
+        Put(I, false);
+    }
+    Mask = OptimizedMask;
+    Energy = OptimizedEnergy;
+    for (int N = Initial; N < Count; ++N)
+    {
+        const int I = Find(false);
+        Ranks[I] = uint32_t(N);
+        Put(I, true);
+    }
+}
+
+} // namespace Detail
+
+// Layout shared with CloudWeatherField.slang. One read-only binding, no assets
+// or per-frame bakes: Shape (RG), erosion (RGBA), blue ranks (integer 0..4095).
+[[nodiscard]] inline const std::vector<uint32_t>& QueryTexels()
+{
+    static const auto Texels = []
+    {
+        using namespace Detail;
+        std::vector<uint32_t> Data(BlueOffset + BlueSize * BlueSize);
+        const CellularLattice W0(4, 0x37d42741u), W1(8, 0xd59f8191u), W2(16, 0x7a2e883fu), W3(32, 0xbc3617a9u);
+        for (int Z = 0; Z < BaseSize; ++Z)
+        for (int Y = 0; Y < BaseSize; ++Y)
+        for (int X = 0; X < BaseSize; ++X)
+        {
+            const Point P {float(X) / BaseSize, float(Y) / BaseSize, float(Z) / BaseSize};
+            const float Gradient = 0.71f * Perlin(P, 4, 15u) + 0.22f * Perlin(P, 8, 65u) + 0.07f * Perlin(P, 16, 95u);
+            const float Cell = 0.71f * W0.Sample(P) + 0.21f * W1.Sample(P) + 0.08f * W2.Sample(P);
+            const float Shape = 0.47f + 0.78f * Gradient + 0.72f * (Cell - 0.45f);
+            Data[BaseOffset + Index(X, Y, Z, BaseSize)] = Unorm(Shape) | (Unorm(Cell) << 8u);
+        }
+        for (int Z = 0; Z < DetailSize; ++Z)
+        for (int Y = 0; Y < DetailSize; ++Y)
+        for (int X = 0; X < DetailSize; ++X)
+        {
+            const Point P {float(X) / DetailSize, float(Y) / DetailSize, float(Z) / DetailSize};
+            Data[DetailOffset + Index(X, Y, Z, DetailSize)] =
+                Unorm(W0.Sample(P)) | (Unorm(W1.Sample(P)) << 8u) | (Unorm(W2.Sample(P)) << 16u) | (Unorm(W3.Sample(P)) << 24u);
+        }
+        BuildBlueRanks(Data.data() + BlueOffset);
+        return Data;
+    }();
+    return Texels;
+}
+
+} // namespace Frontier::GeometricRaster::CloudNoiseVolume
