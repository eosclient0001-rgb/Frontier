new file mode 100644
index 0000000..551b5ba
--- /dev/null
+++ b/Exhibits/CloudProof/CloudProofCompute.slang
@@ -0,0 +1,288 @@
+/*==========================================================================================================================================
+                                                          CLOUDPROOFCOMPUTE.SLANG
+==========================================================================================================================================*/
+// 🧩 Offscreen cloud and atmosphere views using the native transport functions.
+
+[[vk::binding(1, 0)]] StructuredBuffer<uint> PlanetaryCloudNoise;
+#include "../../Engine/Shaders/Atmosphere/CloudAerialPerspective.slang"
+
+struct CloudProofInputs
+{
+    float4 OriginWindX; // xyz local camera position, w = wind displacement X in meters.
+    float4 ForwardWindY; // xyz camera forward, w = wind displacement Y in meters.
+    float4 RightTanX;
+    float4 UpTanY;
+    float4 SunIntensity;
+    float4 FloorThicknessCoverageExtinction;
+    float4 ScaleSeedPhaseExposure;
+    float4 Air;
+    uint4 Flags; // mode (0=ocean, 1=earth, 2=vacuum), view steps, light steps, sky shafts.
+    uint4 Size;  // width, height, surface width, surface height.
+    uint4 Tile;  // first row, row count, pixel samples, diagnostics selector.
+};
+
+[[vk::binding(0, 0)]] ConstantBuffer<CloudProofInputs> Inputs;
+[[vk::binding(2, 0)]] RWStructuredBuffer<uint> ProofPixels;
+[[vk::binding(3, 0)]] StructuredBuffer<uint> PlanetSurface;
+
+static const float ProofRadius = 6371000.0;
+
+PlanetaryCloudConfig GetProofCloudConfig()
+{
+    PlanetaryCloudConfig C;
+    C.RadiusM = (Inputs.Flags.x == 2u) ? 1737400.0 : ProofRadius;
+    C.FloorM = Inputs.FloorThicknessCoverageExtinction.x;
+    C.ThicknessM = Inputs.FloorThicknessCoverageExtinction.y;
+    C.Coverage = Inputs.FloorThicknessCoverageExtinction.z;
+    C.Extinction = Inputs.FloorThicknessCoverageExtinction.w;
+    C.FeatureScale = Inputs.ScaleSeedPhaseExposure.x;
+    C.Seed = Inputs.ScaleSeedPhaseExposure.y;
+    C.PhaseG = Inputs.ScaleSeedPhaseExposure.z;
+    C.PixelAngle = 2.0 * Inputs.UpTanY.w / float(Inputs.Size.y);
+    C.WindOffsetM = float2(Inputs.OriginWindX.w, Inputs.ForwardWindY.w);
+    C.Shear = 0.45;
+    C.Veer = 0.0;
+    C.Turbulence = 0.28;
+    C.Anvil = 0.24;
+    C.SunDirection = normalize(Inputs.SunIntensity.xyz);
+    C.SolarIrradiance = float3(Inputs.SunIntensity.w);
+    C.SkyAmbient = float3(0.37, 0.46, 0.62) * (Inputs.SunIntensity.w / 15.0);
+    C.AtmosphereStrengths = (Inputs.Flags.x == 2u) ? float3(0.0) : Inputs.Air.xyz;
+    C.AirScaleHeightsM = float2(8000.0, Inputs.Flags.x == 1u ? 1200.0 : 1850.0);
+    C.PrimaryKind = 0u;
+    C.Formation = 2u;
+    C.Steps = Inputs.Flags.y;
+    C.LightSteps = Inputs.Flags.z;
+    C.UseClouds = Inputs.Flags.x != 2u;
+    C.UseCloudShadows = C.UseClouds;
+    return C;
+}
+
+float3 ReadProofSurface(uint2 I)
+{
+    uint V = PlanetSurface[I.y * Inputs.Size.z + I.x];
+    return pow(DecodeCloudTexel(V).rgb, float3(2.2));
+}
+
+float3 OrbitAlbedo(float3 N, float Meridian)
+{
+    float U = frac(atan2(N.x, N.z) / (2.0 * CloudTransportPi) + 0.5 + Meridian);
+    float V = acos(clamp(N.y, -1.0, 1.0)) / CloudTransportPi;
+    float2 P = float2(U, V) * float2(Inputs.Size.zw) - 0.5;
+    int2 I = int2(floor(P));
+    float2 F = frac(P);
+    int W = int(Inputs.Size.z), H = int(Inputs.Size.w);
+    int X = (I.x + W) % W, X1 = (X + 1) % W;
+    int Y = clamp(I.y, 0, H - 1), Y1 = clamp(I.y + 1, 0, H - 1);
+    return lerp(lerp(ReadProofSurface(uint2(X, Y)), ReadProofSurface(uint2(X1, Y)), F.x),
+                lerp(ReadProofSurface(uint2(X, Y1)), ReadProofSurface(uint2(X1, Y1)), F.x), F.y);
+}
+
+float3 ProofGround(PlanetaryCloudConfig C, float3 P, float3 D, float HitM, float CoverageShadow)
+{
+    float3 N = normalize(P);
+    float3 SunT = CloudSolarAirTransmittance(C, P + N * 2.0) * CoverageShadow;
+    float SunUp = saturate(dot(N, C.SunDirection));
+    float3 UnitSun = C.SolarIrradiance / CloudTransportPi;
+    if (Inputs.Flags.x == 1u)
+    {
+        float3 Surface = OrbitAlbedo(N, Inputs.Air.w);
+        float Ocean = smoothstep(0.0, 0.07, Surface.b - Surface.r);
+        float3 H = normalize(C.SunDirection - D);
+        float Spec = Ocean * pow(saturate(dot(N, H)), 345.0) * 0.35;
+        return Surface * UnitSun * (SunUp * SunT + 0.022) + UnitSun * SunT * Spec;
+    }
+    if (Inputs.Flags.x == 2u) return float3(0.16, 0.15, 0.14) * SunUp;
+
+    float2 World = P.xy;
+    float Fp = max(0.01, HitM * C.PixelAngle);
+    float2 Slope = float2(0.0);
+    const float2 WaveDir[5] = {float2(0.87, 0.493), float2(-0.44, 0.898), float2(0.14, 0.99), float2(0.61, -0.79), float2(-0.17, 0.986)};
+    const float Waves[5] = {15.0, 6.7, 2.4, 0.97, 0.36};
+    for (uint I = 0u; I < 5u; ++I)
+    {
+        float L = Waves[I];
+        // Account for grazing projection so tiny wave normals disappear well
+        // before they produce rings in the distant reflection.
+        float Fade = 1.0 - smoothstep(L * 0.065, L * 0.37, Fp / max(0.025, abs(dot(D, N))));
+        if (Fade <= 0.0) continue;
+        float Phase = StormNoise(float3(World * (0.61 / L), 61.9 + float(I) * 3.72));
+        float Angle = dot(World, WaveDir[I]) * (6.2831853 / L) + Phase * 7.2;
+        Slope += WaveDir[I] * cos(Angle) * (0.022 + float(I) * 0.005) * Fade;
+    }
+    float3 WaterN = normalize(N + float3(Slope, 0.0));
+    float3 ReflD = reflect(D, WaterN);
+    float View = abs(dot(D, WaterN));
+    float Fresnel = 0.021 + 0.979 * pow(1.0 - saturate(View), 5.0);
+    float SkyDot = max(0.0, dot(ReflD, N));
+    float3 H = normalize(C.SunDirection - D);
+    float HalfAngle = saturate(dot(H, WaterN));
+    float Glint = pow(HalfAngle, lerp(3800.0, 640.0, smoothstep(0.5, 15.0, Fp))) * 2.4 + 0.1 * pow(HalfAngle, 120.0);
+    float3 DayColor = lerp(float3(0.31, 0.45, 0.57), float3(0.090, 0.23, 0.49), smoothstep(0.0, 0.65, SkyDot));
+    float Day = smoothstep(-0.10, 0.31, SunUp + dot(N, C.SunDirection) * 0.4);
+    float3 Twilight = float3(0.22, 0.098, 0.048) * (0.50 + 0.50 * dot(ReflD, C.SunDirection));
+    float MacroWave = StormNoise(float3(World * 0.018, 76.7)) - 0.5;
+    float3 Sky = lerp(Twilight, DayColor, Day) * (0.25 + 0.34 * Day + 0.11 * MacroWave);
+    float3 Base = float3(0.0105, 0.028, 0.038) * (0.39 + 0.61 * CoverageShadow) * (0.3 + 1.25 * Day);
+    return Base + Fresnel * Sky + Glint * SunT;
+}
+
+float3 TraceProofRay(PlanetaryCloudConfig C, float3 Origin, float3 Direction, float2 Pixel)
+{
+    float GroundM = PlanetCloudGroundDistance(Origin, Direction, C.RadiusM);
+    PlanetaryCloudResult Cloud = TracePlanetaryClouds(C, Origin, Direction, Pixel, GroundM);
+    if (Inputs.Tile.w == 1u) return float3(Cloud.Transmittance);
+    if (Inputs.Flags.x == 2u) return float3(0.0);
+    bool Shafts = Inputs.Flags.w > 0u;
+    CloudAirSegment Air = IntegrateCloudAir(C, Origin, Direction, GroundM, 24u, Shafts);
+    float3 Behind = float3(0.0);
+    if (GroundM < 1.0e8)
+    {
+        float3 Ground = Origin + Direction * GroundM;
+        float Foot = (Inputs.Flags.x == 1u) ? max(GroundM * C.PixelAngle, 2350.0) : 0.0;
+        float Shadow = exp(-CloudSolarOpticalDepth(C, Ground, 6u, Foot));
+        Behind = ProofGround(C, Ground, Direction, GroundM, Shadow);
+    }
+    else
+    {
+        float Cos = dot(Direction, C.SunDirection);
+        float Disc = smoothstep(0.9999863, 0.9999898, Cos);
+        float Aureole = exp(-max(0.0, 1.0 - Cos) * 1870.0);
+        Behind = C.SolarIrradiance * (5.5 * Disc + 0.037 * Aureole);
+    }
+    float3 Under = Air.Radiance + Air.Transmittance * Behind;
+    return Under * Cloud.Transmittance + CloudRadianceThroughAir(C, Origin, Direction, Cloud, 12u);
+}
+
+float3 ProofTonemap(float3 X)
+{
+    X = max(float3(0.0), X * Inputs.ScaleSeedPhaseExposure.w);
+    // Luminance-preserving shoulder to keep dusk colors and white cores from
+    // taking on hard channel-clip edges.
+    float L = dot(X, float3(0.2126, 0.7152, 0.0722));
+    X /= (1.0 + L);
+    float Peak = max(X.r, max(X.g, X.b));
+    X = lerp(X, float3(L / (1.0 + L)), smoothstep(0.79, 1.19, Peak) * 0.85);
+    return select(X <= 0.0031308, X * 12.92, 1.055 * pow(max(float3(1.0e-7), X), float3(1.0 / 2.4)) - 0.055);
+}
+
+// These numerical checks run in the same shader and through the same ABI
+// as the proof images. Green encodes pass; red encodes a failed invariant.
+bool CloudProofInvariant(PlanetaryCloudConfig C, uint Case)
+{
+    float R = C.RadiusM;
+    float3 Up = float3(0.0, 0.0, 1.0);
+    PlanetaryCloudLayer L = MakePlanetCloudLayer(1000.0, 1000.0, 0.5, 0.005, 0u);
+    if (Case == 0u)
+    {
+        float4 Span = PlanetCloudLayerSpans(Up * (R + 90.0), Up, R, L, 1.0e8);
+        return abs(Span.z - 910.0) < 1.0 && abs(Span.w - 1910.0) < 1.0 && Span.y <= Span.x;
+    }
+    if (Case == 1u)
+    {
+        float4 Span = PlanetCloudLayerSpans(Up * (R + 1400.0), Up, R, L, 1.0e8);
+        return abs(Span.x) < 1.0 && abs(Span.y - 600.0) < 1.0 && Span.w <= Span.z;
+    }
+    if (Case == 2u)
+    {
+        float3 O = Up * (R + 800000.0);
+        float End = PlanetCloudGroundDistance(O, -Up, R);
+        float4 S = PlanetCloudLayerSpans(O, -Up, R, L, End);
+        return abs(End - 800000.0) < 1.0 && abs(S.x - 798000.0) < 1.0 &&
+               abs(S.y - 799000.0) < 1.0 && S.w <= S.z;
+    }
+    if (Case == 3u)
+    {
+        // A limb ray that misses the inner shell remains an unbroken segment.
+        float4 S = PlanetCloudLayerSpans(float3(-120000.0, 0.0, R + 1500.0), float3(1.0, 0.0, 0.0), R, L, 500000.0);
+        return S.y > S.x && S.w <= S.z;
+    }
+    if (Case == 4u)
+    {
+        C.SunDirection = normalize(float3(1.0, 0.0, -0.038));
+        float3 Low = CloudSolarAirTransmittance(C, Up * (R + 1200.0));
+        float3 High = CloudSolarAirTransmittance(C, Up * (R + 10100.0));
+        return Low.r == 0.0 && High.r > 0.01 && High.r > High.b;
+    }
+    if (Case == 5u)
+    {
+#ifdef FRONTIER_CLOUD_GPU_DIAGNOSTICS
+        float4 Base = SampleCloudVolume(float3(0.125, 0.25, 0.375), 128u, 0u);
+        float4 Detail = SampleCloudVolume(float3(0.26, 0.14, 0.72), 64u, CloudDetailOffset);
+        float Blue = CloudBlueJitter(float2(17.0, 23.0));
+        return Base.r > 0.0 && abs(Base.r - Base.g) > 0.001 && max(Detail.r, Detail.b) > 0.0 &&
+               Blue > 0.0 && Blue < 1.0 && Blue == CloudBlueJitter(float2(81.0, 23.0));
+#else
+        C.UseClouds = false;
+        C.Coverage = 1.0;
+        C.Extinction = 4.0;
+        PlanetaryCloudResult V = TracePlanetaryClouds(C, Up * (R + 1410.0), Up, float2(0.0), 1.0e8);
+        return V.Transmittance == 1.0 && all(V.Radiance == 0.0) &&
+               CloudSolarOpticalDepth(C, Up * R, 4u) == 0.0;
+#endif
+    }
+    if (Case == 6u)
+    {
+        float Sum = 0.0;
+        for (uint I = 0u; I < 1024u; ++I)
+        {
+            float Mu = (float(I) + 0.5) / 512.0 - 1.0;
+            Sum += CloudDualLobe(Mu, 0.84, 1.0);
+        }
+        return abs(Sum * (4.0 * CloudTransportPi / 1024.0) - 1.0) < 0.004 &&
+               CloudDualLobe(1.0, 0.84, 1.0) > CloudDualLobe(-1.0, 0.84, 1.0);
+    }
+    if (Case == 8u)
+    {
+        float3 Axis = normalize(float3(0.18, 0.07, 1.0));
+        float3 Position = normalize(float3(0.20, -0.12, 1.0));
+        float3 Turned = CurveWeatherFront(Position, Axis, 0.32, 2.55);
+        float3 Restored = CurveWeatherFront(Turned, Axis, 0.32, -2.55);
+        // Allow roundoff from implementation-dependent Vulkan sin/cos.
+        return abs(length(Turned) - 1.0) < 5.0e-5 &&
+               length(Restored - Position) < 5.0e-5 && length(Turned - Position) > 0.02;
+    }
+    for (uint I = 0u; I < 3u; ++I)
+    {
+        C.PrimaryKind = I;
+        PlanetaryCloudLayer Low = PlanetCloudLayer(C, 0u);
+        PlanetaryCloudLayer Mid = PlanetCloudLayer(C, 1u);
+        PlanetaryCloudLayer High = PlanetCloudLayer(C, 2u);
+        if (!(Low.TopM < Mid.BottomM && Mid.TopM < High.BottomM)) return false;
+    }
+    return true;
+}
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void CloudProofEntry(uint3 ID : SV_DispatchThreadID)
+{
+    if (ID.x >= Inputs.Size.x || ID.y >= Inputs.Tile.y) return;
+    uint2 Coord = uint2(ID.x, ID.y + Inputs.Tile.x);
+    PlanetaryCloudConfig C = GetProofCloudConfig();
+#ifdef FRONTIER_CLOUD_GPU_DIAGNOSTICS
+    ProofPixels[ID.y * Inputs.Size.x + ID.x] = CloudProofInvariant(C, ID.x) ? 0xff00ff00u : 0xff0000ffu;
+#else
+    if (Inputs.Tile.w == 2u)
+    {
+        ProofPixels[ID.y * Inputs.Size.x + ID.x] = CloudProofInvariant(C, ID.x) ? 0xff00ff00u : 0xff0000ffu;
+        return;
+    }
+    float3 Origin = Inputs.OriginWindX.xyz;
+    Origin.z += C.RadiusM;
+    float3 L = float3(0.0);
+    uint Samples = max(1u, Inputs.Tile.z);
+    for (uint S = 0u; S < Samples; ++S)
+    {
+        float2 Subpixel = (Samples == 1u) ? float2(0.5) : frac(float2(0.5) + (float(S) + 0.5) * float2(0.754877667, 0.569840296));
+        float2 Ndc = ((float2(Coord) + Subpixel) / float2(Inputs.Size.xy) * 2.0 - 1.0) * float2(1.0, -1.0);
+        float3 D = normalize(Inputs.ForwardWindY.xyz + Ndc.x * Inputs.RightTanX.w * Inputs.RightTanX.xyz +
+                                 Ndc.y * Inputs.UpTanY.w * Inputs.UpTanY.xyz);
+        L += TraceProofRay(C, Origin, D, float2(Coord) + float2(11u * S, 29u * S));
+    }
+    float3 Out = (Inputs.Tile.w == 1u) ? L / float(Samples) : ProofTonemap(L / float(Samples));
+    float Dither = (CloudBlueJitter(float2(Coord) + float2(19.0, 31.0)) - 0.5) / 255.0;
+    uint3 Rgb = uint3(round(saturate(Out + Dither) * 255.0));
+    ProofPixels[ID.y * Inputs.Size.x + ID.x] = Rgb.x | (Rgb.y << 8u) | (Rgb.z << 16u) | 0xff000000u;
+#endif
+}
