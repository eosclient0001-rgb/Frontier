index 0000000..c907550
--- /dev/null
+++ b/Engine/Shaders/Atmosphere/CloudWeatherField.slang
@@ -0,0 +1,146 @@
+/*==========================================================================================================================================
+                                                          CLOUDWEATHERFIELD.SLANG
+==========================================================================================================================================*/
+// 🧩 Packed 3D noise access and seamless planetary weather synthesis.
+
+#ifndef FRONTIER_CLOUD_WEATHER_FIELD
+#define FRONTIER_CLOUD_WEATHER_FIELD 1
+
+// Bind this read-only volume before including the module. The packed layout
+// also works on hardware without filterable 3D formats.
+static const uint CloudDetailOffset = 128u * 128u * 128u;
+static const uint CloudBlueOffset = CloudDetailOffset + 64u * 64u * 64u;
+
+float4 DecodeCloudTexel(uint W)
+{
+    return float4(W & 255u, (W >> 8u) & 255u, (W >> 16u) & 255u, W >> 24u) * (1.0 / 255.0);
+}
+
+uint ReadCloudTexel(int3 P, uint S, uint Offset)
+{
+    uint3 I = uint3(P) & (S - 1u);
+    return PlanetaryCloudNoise[Offset + (I.z * S + I.y) * S + I.x];
+}
+
+float4 SampleCloudVolume(float3 Uv, uint Size, uint Offset)
+{
+    float3 P = frac(Uv) * float(Size);
+    int3 C = int3(P);
+    float3 F = P - float3(C);
+    float4 X00 = lerp(DecodeCloudTexel(ReadCloudTexel(C, Size, Offset)),
+                      DecodeCloudTexel(ReadCloudTexel(C + int3(1, 0, 0), Size, Offset)), F.x);
+    float4 X10 = lerp(DecodeCloudTexel(ReadCloudTexel(C + int3(0, 1, 0), Size, Offset)),
+                      DecodeCloudTexel(ReadCloudTexel(C + int3(1, 1, 0), Size, Offset)), F.x);
+    float4 X01 = lerp(DecodeCloudTexel(ReadCloudTexel(C + int3(0, 0, 1), Size, Offset)),
+                      DecodeCloudTexel(ReadCloudTexel(C + int3(1, 0, 1), Size, Offset)), F.x);
+    float4 X11 = lerp(DecodeCloudTexel(ReadCloudTexel(C + int3(0, 1, 1), Size, Offset)),
+                      DecodeCloudTexel(ReadCloudTexel(C + int3(1, 1, 1), Size, Offset)), F.x);
+    return lerp(lerp(X00, X10, F.y), lerp(X01, X11, F.y), F.z);
+}
+
+float CloudBlueJitter(float2 Pixel)
+{
+    uint2 I = uint2(abs(Pixel)) & 63u;
+    return (float(PlanetaryCloudNoise[CloudBlueOffset + I.y * 64u + I.x]) + 0.5) / 4096.0;
+}
+
+uint StormHash(int3 Cell)
+{
+    uint V = uint(Cell.x) * 0x9e3779b1u ^ uint(Cell.y) * 0x85ebca77u ^ uint(Cell.z) * 0xc2b2ae3du;
+    V = (V ^ (V >> 16u)) * 0x7feb352du;
+    V = (V ^ (V >> 15u)) * 0x846ca68bu;
+    return V ^ (V >> 16u);
+}
+
+float StormCorner(int3 Cell)
+{
+    return float(StormHash(Cell) >> 8u) / 16777216.0;
+}
+
+float3 CloudQuintic(float3 F)
+{
+    return F * F * F * (F * (6.0 * F - 15.0) + 10.0);
+}
+
+// Unbounded integer lattice, evaluated in planetary Cartesian coordinates.
+// It has neither a weather-map repeat interval nor a cubemap/dateline seam.
+float StormNoise(float3 P)
+{
+    int3 I = int3(floor(P));
+    float3 U = CloudQuintic(P - float3(I));
+    float A = lerp(StormCorner(I), StormCorner(I + int3(1, 0, 0)), U.x);
+    float B = lerp(StormCorner(I + int3(0, 1, 0)), StormCorner(I + int3(1, 1, 0)), U.x);
+    float C = lerp(StormCorner(I + int3(0, 0, 1)), StormCorner(I + int3(1, 0, 1)), U.x);
+    float D = lerp(StormCorner(I + int3(0, 1, 1)), StormCorner(I + int3(1, 1, 1)), U.x);
+    return lerp(lerp(A, B, U.y), lerp(C, D, U.y), U.z);
+}
+
+float3 RotateCloudOctave(float3 P)
+{
+    return float3(dot(P, float3(0.80, -0.60, 0.0)),
+                  dot(P, float3(0.48, 0.64, -0.60)),
+                  dot(P, float3(0.36, 0.48, 0.80)));
+}
+
+// Finite-difference curl of a scalar potential in the horizontal plane.
+// Evaluate it only on active density boundaries.
+float2 CloudBoundaryCurl(float3 Q)
+{
+    const float E = 0.063;
+    float Dx = StormNoise(Q + float3(E, 0.0, 0.0)) - StormNoise(Q - float3(E, 0.0, 0.0));
+    float Dy = StormNoise(Q + float3(0.0, E, 0.0)) - StormNoise(Q - float3(0.0, E, 0.0));
+    return float2(Dy, -Dx) / (2.0 * E);
+}
+
+float3 CurveWeatherFront(float3 P, float3 Axis, float Reach, float Spin)
+{
+    float3 V = P - Axis;
+    float Envelope = saturate(1.0 - dot(V, V) / (Reach * Reach));
+    if (Envelope <= 0.0) return P;
+    // Angle depends only on distance to the axis. Azimuth-dependent turns can
+    // fold the field and print multiple copies of one front along a single arc.
+    float Turn = Spin * Envelope * Envelope;
+    float S = sin(Turn), C = cos(Turn);
+    return P * C + cross(Axis, P) * S + Axis * dot(Axis, P) * (1.0 - C);
+}
+
+struct CloudWeatherSample
+{
+    float Moisture;
+    float Type;
+    float Lift;
+    float Rain;
+    float Bands;
+};
+
+CloudWeatherSample EvaluateCloudWeather(float3 N, float Seed)
+{
+    // Seed displaces decorrelated octaves, not the camera or the planet.
+    float3 Q = N * 8.2 + float3(12.8, -7.9, 42.1) + Seed * float3(0.73, -0.46, 1.17);
+    float3 W = float3(StormNoise(Q), StormNoise(Q + float3(9.1, 21.3, -5.4)),
+                      StormNoise(Q + float3(-8.2, 3.7, 17.1))) - 0.5;
+    float3 A = CurveWeatherFront(N + 0.019 * W, normalize(float3(0.18, 0.07, 1.0)), 0.27, 2.55);
+    A = CurveWeatherFront(A, normalize(float3(0.26, -0.36, 0.9)), 0.30, -2.05);
+    A = CurveWeatherFront(A, normalize(float3(-0.8, 0.35, -0.51)), 0.46, 3.9);
+    float3 Eddies = float3(StormNoise(A * 63.0 + Seed - 29.0), StormNoise(A * 64.0 + Seed + 53.0),
+                           StormNoise(A * 62.0 + Seed + 15.3)) - 0.5;
+    A += 0.007 * Eddies;
+    float LatitudeMix = A.y + 0.067 * W.z;
+    float Belt = 1.0 - smoothstep(0.0, 0.19, abs(abs(LatitudeMix) - 0.36));
+    float Fronts = StormNoise(float3(A.x * 22.0, A.y * 58.0, A.z * 27.0) + W * 3.0 + Seed);
+    float Ridged = pow(saturate(1.0 - 2.0 * abs(Fronts - 0.51)), 2.5);
+    float Moist = StormNoise(A * 16.0 + W * 2.0 + Seed + 6.0);
+    float Patch = StormNoise(RotateCloudOctave(A * 140.0) + W * 5.0 + Seed);
+    float Mesoscale = StormNoise(RotateCloudOctave(A * 405.0) + 17.4 + Seed);
+    float Curtains = StormNoise(RotateCloudOctave(A * 245.0) + Eddies * 3.1 + float3(9.2, 63.4, 20.1));
+    float M = 0.34 * Moist + 0.16 * Ridged + 0.19 * Patch + 0.11 * Mesoscale + 0.20 * Curtains + 0.05 * Belt;
+    CloudWeatherSample Out;
+    Out.Moisture = saturate((M - 0.20) * 1.68);
+    Out.Type = saturate(0.26 + 0.74 * Patch - 0.30 * Belt);
+    Out.Lift = saturate(0.68 * Mesoscale + 0.32 * Patch);
+    Out.Rain = smoothstep(0.59, 0.87, Out.Moisture + 0.16 * Out.Lift);
+    Out.Bands = saturate(0.40 * Ridged + 0.27 * Moist + 0.33 * Patch);
+    return Out;
+}
+
+#endif
diff --git a/Engine/Shaders/Atmosphere/PlanetaryCloudTransport.slang b/Engine/Shaders/Atmosphere/PlanetaryCloudTransport.slang
new file mode 100644
index 0000000..a7e5cdb
--- /dev/null
+++ b/Engine/Shaders/Atmosphere/PlanetaryCloudTransport.slang
@@ -0,0 +1,607 @@
+/*==========================================================================================================================================
+                                                       PLANETARYCLOUDTRANSPORT.SLANG
+==========================================================================================================================================*/
+// 🧩 Layered cloud extinction, solar optical depth, and spherical view integration.
+
+#ifndef FRONTIER_PLANETARY_CLOUD_TRANSPORT
+#define FRONTIER_PLANETARY_CLOUD_TRANSPORT 1
+
+#include "CloudWeatherField.slang"
+
+static const float CloudTransportPi = 3.14159265359;
+
+struct PlanetaryCloudConfig
+{
+    float RadiusM;
+    float Coverage;
+    float Extinction;
+    float FloorM;
+    float ThicknessM;
+    float FeatureScale;
+    float Anvil;
+    float PhaseG;
+    float Seed;
+    float PixelAngle;
+    float2 WindOffsetM;
+    float Shear;
+    float Veer;
+    float Turbulence;
+    float3 SunDirection;
+    float3 SolarIrradiance; // Top-of-atmosphere, not attenuated at the observer.
+    float3 SkyAmbient;
+    float3 AtmosphereStrengths; // Rayleigh, aerosol, ozone.
+    float2 AirScaleHeightsM;
+    uint Steps;
+    uint LightSteps;
+    uint PrimaryKind; // 0 = water convection, 1 = stratiform water, 2 = ice.
+    uint Formation;
+    bool UseClouds;
+    bool UseCloudShadows;
+};
+
+struct PlanetaryCloudLayer
+{
+    float BottomM;
+    float TopM;
+    float Amount;
+    float Sigma;
+    uint Kind;
+};
+
+struct PlanetaryCloudInterval
+{
+    float NearM;
+    float FarM;
+    uint Layer;
+};
+
+struct PlanetaryCloudResult
+{
+    float3 Radiance;
+    float Transmittance;
+    float DistanceM;
+};
+
+float PlanetCloudAltitude(float3 P, float R)
+{
+    return length(P) - R;
+}
+
+// Stable roots when a camera is centimeters to meters from a sphere with a
+// radius measured in megameters. The sentinel has Far < Near.
+float2 PlanetCloudSphere(float3 P, float3 D, float R)
+{
+    float Rp = length(P);
+    float B = dot(P, D);
+    float C = (Rp - R) * (Rp + R);
+    float Disc = B * B - C;
+    if (Disc < 0.0) return float2(1.0, -1.0);
+    float Q = -B - ((B < 0.0) ? -1.0 : 1.0) * sqrt(Disc);
+    float Other = (abs(Q) > 1.0e-6) ? C / Q : Q;
+    return float2(min(Q, Other), max(Q, Other));
+}
+
+float PlanetCloudGroundDistance(float3 Origin, float3 Direction, float RadiusM)
+{
+    float2 Ground = PlanetCloudSphere(Origin, Direction, RadiusM);
+    if (Ground.x > Ground.y || Ground.y <= 0.0) return 1.0e9;
+    if (Ground.x > 0.0) return Ground.x;
+    return (dot(Origin, Direction) < 0.0) ? 0.0 : 1.0e9;
+}
+
+PlanetaryCloudLayer MakePlanetCloudLayer(float Bottom, float Thickness, float Amount, float Sigma, uint Kind)
+{
+    PlanetaryCloudLayer L;
+    L.BottomM = Bottom;
+    L.TopM = Bottom + max(40.0, Thickness);
+    L.Amount = Amount;
+    L.Sigma = Sigma;
+    L.Kind = Kind;
+    return L;
+}
+
+PlanetaryCloudLayer PlanetCloudLayer(PlanetaryCloudConfig C, uint I)
+{
+    float FloorM = max(60.0, C.FloorM);
+    float DepthM = clamp(C.ThicknessM, 100.0, 8000.0);
+    float LowFloor = (C.PrimaryKind == 0u) ? FloorM : min(1260.0, FloorM * 0.50);
+    float LowDepth = (C.PrimaryKind == 0u) ? DepthM : max(100.0, min(1500.0, FloorM - LowFloor - 200.0));
+    float StratFloor = max(4150.0, LowFloor + LowDepth + 200.0);
+    float StratDepth = 1680.0;
+    if (C.PrimaryKind == 1u)
+    {
+        StratFloor = max(LowFloor + LowDepth + 160.0, FloorM);
+        StratDepth = DepthM;
+    }
+    if (C.PrimaryKind == 2u)
+    {
+        StratFloor = max(LowFloor + LowDepth + 160.0, min(StratFloor, FloorM - 1600.0));
+        StratDepth = clamp(FloorM - StratFloor - 300.0, 100.0, StratDepth);
+    }
+    float IceFloor = max(StratFloor + StratDepth + 300.0, (C.PrimaryKind == 2u) ? FloorM : 8800.0);
+    if (I == 0u)
+        return MakePlanetCloudLayer(LowFloor, LowDepth, (C.PrimaryKind == 0u ? 1.0 : 0.78) * C.Coverage, 0.0056 * C.Extinction, 0u);
+    if (I == 1u)
+        return MakePlanetCloudLayer(StratFloor, StratDepth, (C.PrimaryKind == 1u ? 1.12 : 0.74) * C.Coverage, 0.0025 * C.Extinction, 1u);
+    return MakePlanetCloudLayer(IceFloor, (C.PrimaryKind == 2u) ? DepthM : 1050.0,
+                                (C.PrimaryKind == 2u ? 1.35 : 0.88) * C.Coverage, 0.00155 * C.Extinction, 2u);
+}
+
+// Subtracting the inner sphere from the outer sphere produces up to two
+// intervals. This handles grazing rays, inward watches from orbit and cameras
+// that start inside the condensate; no assumption about world-space ray.z.
+float4 PlanetCloudLayerSpans(float3 O, float3 D, float R, PlanetaryCloudLayer L, float LimitM)
+{
+    float2 Outer = PlanetCloudSphere(O, D, R + L.TopM);
+    Outer = float2(max(0.0, Outer.x), min(LimitM, Outer.y));
+    if (Outer.y <= Outer.x) return float4(0.0);
+    float2 Inner = PlanetCloudSphere(O, D, R + L.BottomM);
+    if (Inner.y <= Outer.x || Inner.x >= Outer.y || Inner.x >= Inner.y)
+        return float4(Outer, 0.0, 0.0);
+    return float4(Outer.x, min(Outer.y, Inner.x), max(Outer.x, Inner.y), Outer.y);
+}
+
+#ifdef FRONTIER_CLOUD_EXTERNAL_FLOW
+float2 PlanetCloudExternalFlow(float2 WorldXY, float AltitudeM);
+#endif
+
+float3 CloudAdvection(PlanetaryCloudConfig C, float3 P, float AltM, uint Kind)
+{
+#ifdef FRONTIER_CLOUD_EXTERNAL_FLOW
+    P.xy = PlanetCloudExternalFlow(P.xy, AltM);
+#endif
+    float Km = max(0.0, AltM - C.FloorM) * 0.001;
+    float Turn = C.Veer * Km;
+    float Cs = cos(Turn), Sn = sin(Turn);
+    float2 Wind = float2(C.WindOffsetM.x * Cs - C.WindOffsetM.y * Sn,
+                         C.WindOffsetM.x * Sn + C.WindOffsetM.y * Cs);
+    Wind *= 1.0 + 0.31 * float(Kind);
+    Wind.x += Km * C.Shear * 55.0;
+    return P - float3(Wind, 0.0);
+}
+
+// Convective cores are not a height-extruded coverage texture. Each cell has
+// its own tilted condensation column, asymmetric shoulders and size. A second
+// octave of nonperiodic weather shapes the gaps between cell groups.
+float CumulusCellEnvelope(float2 M, float H, float Forced, float Seed)
+{
+    float2 Q = M / 4050.0;
+    float Warp = StormNoise(float3(Q * 0.81, 61.3 + Seed));
+    float2 W = Q + float2(Warp - 0.5, 0.5 - StormNoise(float3(Q * 1.05, 13.8 + Seed))) * 0.72;
+    int2 Cell = int2(floor(W));
+    float Best = -1.0;
+    for (int J = -1; J <= 1; ++J)
+    for (int I = -1; I <= 1; ++I)
+    {
+        int2 K = Cell + int2(I, J);
+        uint Hash = StormHash(int3(K, int(floor(Seed * 53.0))));
+        float4 R = DecodeCloudTexel(Hash);
+        float2 Center = float2(K) + 0.5 + 0.86 * (R.xy - 0.5);
+        float Lift = 0.16 + 0.57 * R.z;
+        float2 Tilt = (R.yz - 0.5) * (0.16 * H + 0.08);
+        float2 D = W - Center - Tilt;
+        if (any(abs(D) > 0.90)) continue;
+        float Size = 0.15 + R.w * (0.27 + 0.10 * R.z) + 0.095 * Forced;
+        float Stretch = 0.74 + 0.76 * R.z;
+        float2 Metric = float2(Stretch, rcp(Stretch)) / (Size * Size);
+        float MainH = (H - (0.30 + 0.31 * Lift)) / (0.16 + 0.29 * Lift);
+        float Main = 1.0 - sqrt(dot(D * D, Metric) + MainH * MainH);
+        float2 Offset = 0.50 * Size * (R.yw * 2.0 - 1.0);
+        float2 B = D - Offset;
+        float BudH = (H - (0.37 + 0.43 * Lift)) / (0.11 + 0.17 * Lift);
+        float Bud = 0.78 * (1.0 - sqrt(dot(B * B, Metric * 1.64) + BudH * BudH));
+        float Field = max(Main, Bud) - 0.37 * saturate(R.w - 0.58 * Forced);
+        Best = max(Best, Field);
+    }
+    return saturate(Best);
+}
+
+CloudWeatherSample CloudWeatherAtPoint(PlanetaryCloudConfig C, float3 P, uint Kind)
+{
+    float Radius = length(P);
+    return EvaluateCloudWeather(CloudAdvection(C, P, Radius - C.RadiusM, Kind) / max(1.0, Radius), C.Seed);
+}
+
+CloudWeatherSample LerpCloudWeather(CloudWeatherSample A, CloudWeatherSample B, float X)
+{
+    CloudWeatherSample W;
+    W.Moisture = lerp(A.Moisture, B.Moisture, X);
+    W.Type = lerp(A.Type, B.Type, X);
+    W.Lift = lerp(A.Lift, B.Lift, X);
+    W.Rain = lerp(A.Rain, B.Rain, X);
+    W.Bands = lerp(A.Bands, B.Bands, X);
+    return W;
+}
+
+float SamplePlanetCloudDensity(PlanetaryCloudConfig C, PlanetaryCloudLayer L, float3 P,
+                               CloudWeatherSample W, float FootprintM, bool LightQuery)
+{
+    float Radius = length(P);
+    float Alt = Radius - C.RadiusM;
+    float LayerH = (Alt - L.BottomM) / (L.TopM - L.BottomM);
+    if (LayerH <= 0.0 || LayerH >= 1.0 || L.Amount <= 0.001) return 0.0;
+
+    float3 Adv = CloudAdvection(C, P, Alt, L.Kind);
+    float MoistureGate = smoothstep(0.15, 0.29, W.Moisture);
+    if (MoistureGate <= 0.0) return 0.0;
+
+    float SynopticLod = smoothstep(460.0, 2100.0, FootprintM);
+    float SynopticDensity = 0.0;
+    if (SynopticLod > 0.0)
+    {
+        float3 Nq = RotateCloudOctave(Adv / Radius);
+        Nq += float(L.Kind) * float3(0.018, -0.013, 0.024);
+        float Clouds = StormNoise(Nq * 440.0 + W.Lift * 1.1 + C.Seed);
+        float Tufts = StormNoise(RotateCloudOctave(Nq * 1010.0) + C.Seed * 2.8);
+        float Broad = 0.44 * W.Moisture + 0.15 * W.Bands + 0.06 * W.Lift + 0.26 * Clouds + 0.09 * Tufts;
+        float H = LayerH + (0.53 - Clouds) * 0.32;
+        float Height = smoothstep(0.04, 0.32, H) * (1.0 - smoothstep(0.54, 0.95, H));
+        Height *= smoothstep(0.0, 0.10, LayerH) * (1.0 - smoothstep(0.90, 1.0, LayerH));
+        float Water = max(0.0, Broad - (0.71 - 0.39 * L.Amount));
+        SynopticDensity = L.Sigma * smoothstep(0.0, 0.19, Water * Height) * Height * MoistureGate;
+        if (SynopticLod >= 1.0) return SynopticDensity;
+    }
+
+    float3 N = P / Radius;
+    float3 M = Adv - float3(0.0, 0.0, C.RadiusM);
+    float3 Q = RotateCloudOctave(M);
+    float Local = StormNoise(Q * 0.00018 + float3(16.7, -12.2, C.Seed));
+    Local = lerp(Local, 0.49, smoothstep(480.0, 5000.0, FootprintM));
+    float Cover = saturate(L.Amount * (0.59 + 1.04 * W.Moisture) + (Local - 0.49) * 0.38);
+    float FilteredMass = SynopticDensity * SynopticLod;
+    if (Cover < 0.105) return FilteredMass;
+    float Raw = -1.0;
+    float HeightMask = 0.0;
+    if (L.Kind == 0u)
+    {
+        // Aperiodic condensate cells collect into mesoscale banks and clearings.
+        float3 TerrainFrame = RotateCloudOctave(N * (C.RadiusM / 7200.0));
+        float Patchiness = StormNoise(TerrainFrame + float3(13.1, 72.9, C.Seed));
+        float FrontArc = StormNoise(RotateCloudOctave(TerrainFrame) * 0.32 + float3(-7.8, C.Seed, 32.6));
+        float Cluster = 0.58 * Patchiness + 0.27 * FrontArc + 0.15 * W.Moisture;
+        float ConvectiveGate = smoothstep(0.25, 0.62, Cluster + 0.12 * (L.Amount - 0.3));
+        if (ConvectiveGate <= 0.001) return FilteredMass;
+        float Type = W.Type;
+        if (C.Formation == 0u) Type *= 0.27;
+        if (C.Formation == 1u) Type = lerp(Type, 0.33, 0.65);
+        if (C.Formation == 3u || C.Formation == 11u) Type = lerp(Type, 0.88, 0.70);
+        float Base = 0.018 + 0.17 * Local + 0.078 * (1.0 - W.Lift);
+        float Top = clamp(0.58 + 0.29 * W.Lift + 0.17 * Local + 0.16 * W.Rain, Base + 0.18, 0.99);
+        float H = saturate((LayerH - Base) / (Top - Base));
+        float Root = smoothstep(0.0, lerp(0.17, 0.27, Type), H);
+        float Cap = 1.0 - smoothstep(lerp(0.56, 0.64, Type), 1.0, H);
+        HeightMask = Root * Cap;
+        if (HeightMask < 0.012) return FilteredMass;
+        float Core = 0.0;
+        if (SynopticLod < 0.999)
+        {
+            float3 ConstantAltitude = Adv - N * Alt;
+            float3 Blend = smoothstep(float3(0.43), float3(0.79), abs(N));
+            Blend *= Blend;
+            if (Blend.z > 0.0) Core += Blend.z * CumulusCellEnvelope(ConstantAltitude.xy, LayerH, Cover, C.Seed);
+            if (Blend.x > 0.0) Core += Blend.x * CumulusCellEnvelope(ConstantAltitude.yz, LayerH, Cover, C.Seed + 23.0);
+            if (Blend.y > 0.0) Core += Blend.y * CumulusCellEnvelope(ConstantAltitude.xz, LayerH, Cover, C.Seed + 59.0);
+            Core /= max(0.01, Blend.x + Blend.y + Blend.z);
+        }
+        float Period = 4560.0 * clamp(sqrt(max(0.1, C.FeatureScale) / 0.35), 0.46, 2.45);
+        float3 Bow = float3(C.Anvil * (160.0 * H * H + 420.0 * W.Rain * H * H), 96.0 * H, 0.0);
+        float3 BaseQ = RotateCloudOctave(M - Bow + N * Alt * lerp(0.96, 0.12, Type));
+        float3 Uv = BaseQ / Period + float3(0.143, 0.713, 0.337) + 0.137 * C.Seed;
+        float2 Shape = SampleCloudVolume(Uv, 128u, 0u).rg;
+        float Signal = Shape.x + 0.20 * (Shape.y - 0.47);
+        if (SynopticLod < 0.99)
+        {
+            float B = SampleCloudVolume(RotateCloudOctave(Uv) * 2.37 + float3(0.77, 0.38, 0.12), 128u, 0u).r;
+            Signal = lerp(Signal, B, 0.22 + 0.17 * Local) + 0.09 * (B - 0.44);
+        }
+        float CoreGain = lerp(0.75, 1.06, Type);
+        float Threshold = lerp(0.86, 0.53, saturate(Cover * 1.3)) + 0.41 * (1.0 - HeightMask);
+        Raw = Signal + Core * CoreGain * (0.59 + 0.64 * ConvectiveGate) - Threshold - 0.17 * (1.0 - ConvectiveGate);
+    }
+    else if (L.Kind == 1u)
+    {
+        float Fold = StormNoise(Q * 0.00051 + 37.1);
+        float H = LayerH - (Fold - 0.5) * 0.39;
+        HeightMask = smoothstep(0.06, 0.38, H) * (1.0 - smoothstep(0.58, 0.965, H));
+        if (HeightMask < 0.01) return FilteredMass;
+        float3 Uv = RotateCloudOctave(Adv + N * Alt * 3.1) / 6900.0 + float3(0.861, 0.51, 0.26);
+        float2 Billow = SampleCloudVolume(Uv, 128u, 0u).rg;
+        float Signal = lerp(Billow.x, Billow.y, 0.34) + 0.15 * (Fold - 0.5);
+        Raw = Signal - lerp(0.713, 0.370, saturate(Cover * 1.16)) - 0.32 * (1.0 - HeightMask);
+    }
+    else
+    {
+        float3 Fiber = RotateCloudOctave(Q + N * Alt * 3.5);
+        float Lobe = StormNoise(Fiber * float3(0.000095, 0.00026, 0.00012) + 41.3);
+        float Shear = StormNoise(Fiber * float3(0.00012, 0.00049, 0.00016) - 23.0);
+        float H = LayerH - (Lobe - 0.49) * 0.48;
+        HeightMask = smoothstep(0.08, 0.36, H) * (1.0 - smoothstep(0.52, 0.92, H));
+        if (HeightMask < 0.01) return FilteredMass;
+        // A nonperiodic field stretched along the flow gives strands of
+        // different lengths and curvature, without a repeating comb across
+        // the high deck. Bend each octave before mixing its density.
+        float3 Qice = Fiber * float3(0.000115, 0.00081, 0.00022);
+        Qice.y += (Lobe - 0.50) * 2.55 + 1.34 * (Shear - 0.5) + H * H * 0.50;
+        Qice.z += Lobe * 0.66;
+        float BroadFiber = StormNoise(Qice + float3(3.7, 27.2, 59.1));
+        float FineFiber = StormNoise(RotateCloudOctave(Qice * float3(2.37, 2.78, 2.1)) + 16.9);
+        FineFiber = lerp(FineFiber, 0.50, smoothstep(65.0, 350.0, FootprintM));
+        float Filament = 0.74 * BroadFiber + 0.26 * FineFiber;
+        float Strand = 0.49 * Lobe + 0.18 * Shear + 0.33 * Filament;
+        Raw = Strand - lerp(0.78, 0.395, saturate(Cover * 1.38)) - 0.40 * (1.0 - HeightMask);
+    }
+
+    if (Raw <= (LightQuery ? -0.01 : 0.0)) return FilteredMass;
+
+    if (!LightQuery && L.Kind != 2u && Raw < 0.245 && FootprintM < 360.0)
+    {
+        float Fade = 1.0 - smoothstep(65.0, 360.0, FootprintM);
+        float Edge = 1.0 - smoothstep(0.075, 0.245, Raw);
+        float3 ErosionP = RotateCloudOctave(Q);
+        ErosionP.xy += CloudBoundaryCurl(ErosionP / 680.0 + C.Seed) * (36.0 + 53.0 * C.Turbulence) * Edge * Fade;
+        float4 Detail = SampleCloudVolume(ErosionP / 1280.0 + float3(0.419, 0.673, 0.613), 64u, CloudDetailOffset);
+        float Bills = Detail.r * 0.40 + Detail.g * 0.27 + Detail.b * 0.19 + Detail.a * 0.14;
+        float Ridge = saturate((0.72 - Bills) * 1.45);
+        Raw -= (0.088 + 0.142 * LayerH) * Ridge * Edge * Fade;
+    }
+    // Feather to zero with continuous slope so neither the shell nor a hard
+    // density clamp prints through. Rain modulates the core extinction.
+    float Response = (L.Kind == 2u) ? 0.21 : 0.086;
+    float Density = LightQuery ? smoothstep(-0.010, Response + 0.055, Raw) : smoothstep(0.0, Response, Raw);
+    // One continuous extinction blend; no separate painted orbital mask.
+    float LocalDensity = L.Sigma * Density * HeightMask * MoistureGate * (0.72 + 0.80 * W.Rain);
+    return lerp(LocalDensity, SynopticDensity, SynopticLod);
+}
+
+float3 PlanetCloudAirBetaRay(PlanetaryCloudConfig C)
+{
+    return float3(5.802e-6, 13.558e-6, 33.1e-6) * max(0.0, C.AtmosphereStrengths.x);
+}
+
+float3 PlanetCloudAirBetaMie(PlanetaryCloudConfig C)
+{
+    return float3(4.40e-6) * max(0.0, C.AtmosphereStrengths.y);
+}
+
+float CloudAirColumn(float H, float R, float Alt, float Mu)
+{
+    // Chapman tangent limit blended to the plane-parallel secant. On the
+    // downward half of a grazing ray add the tangent column on the far side.
+    float A = abs(Mu);
+    float Up = 2.0 * H / (A + sqrt(A * A + 8.0 * H / (CloudTransportPi * R)));
+    float D = (R + Alt) * Mu * Mu / (1.0 + sqrt(saturate(1.0 - Mu * Mu)));
+    float Down = sqrt(2.0 * CloudTransportPi * (R + Alt) * H) * exp(min(9.0, D / H)) - Up;
+    return exp(-max(0.0, Alt) / H) * ((Mu < 0.0) ? Down : Up);
+}
+
+float3 CloudSolarAirTransmittance(PlanetaryCloudConfig C, float3 P)
+{
+    float R = length(P);
+    float Alt = max(0.0, R - C.RadiusM);
+    float Mu = dot(P, C.SunDirection) / R;
+    float Horizon = -sqrt(saturate(Alt * (R + C.RadiusM) / (R * R)));
+    // Finite solar disc (~0.53 degrees) across the planetary shadow boundary.
+    float Visible = smoothstep(-0.00465, 0.00465, Mu - Horizon);
+    if (Visible <= 0.0) return float3(0.0);
+    float Ray = CloudAirColumn(max(400.0, C.AirScaleHeightsM.x), C.RadiusM, Alt, Mu);
+    float Mie = CloudAirColumn(max(200.0, C.AirScaleHeightsM.y), C.RadiusM, Alt, Mu);
+    float Ozone = 15000.0 * exp(-max(0.0, Alt - 25000.0) / 8000.0) / max(0.15, abs(Mu));
+    float3 Tau = PlanetCloudAirBetaRay(C) * Ray + PlanetCloudAirBetaMie(C) * Mie +
+                 C.AtmosphereStrengths.z * float3(0.650e-6, 1.881e-6, 0.085e-6) * Ozone;
+    return Visible * exp(-Tau);
+}
+
+float CloudLightSpanTau(PlanetaryCloudConfig C, PlanetaryCloudLayer L, float3 P, float2 Span, uint Steps, float FootprintM)
+{
+    if (Span.y <= Span.x) return 0.0;
+    // Bound the work at shallow solar angles. Distant shadows are filtered
+    // with the footprint, not a second, misaligned weather or noise map.
+    float Length = min(Span.y - Span.x, 12500.0);
+    float Tau = 0.0;
+    float A = 0.0;
+    CloudWeatherSample Wa = CloudWeatherAtPoint(C, P + C.SunDirection * Span.x, L.Kind);
+    CloudWeatherSample Wb = CloudWeatherAtPoint(C, P + C.SunDirection * (Span.x + Length), L.Kind);
+    for (uint I = 0u; I < Steps; ++I)
+    {
+        float F = float(I + 1u) / float(Steps);
+        float B = Length * F * F;
+        float T = Span.x + 0.5 * (A + B);
+        float Ds = B - A;
+        CloudWeatherSample W = LerpCloudWeather(Wa, Wb, (T - Span.x) / Length);
+        float D = SamplePlanetCloudDensity(C, L, P + C.SunDirection * T, W, max(FootprintM, 48.0 + 0.55 * Ds), true);
+        Tau += Ds * D;
+        if (Tau >= 18.0) return 18.0;
+        A = B;
+    }
+    return Tau;
+}
+
+float CloudSolarOpticalDepth(PlanetaryCloudConfig C, float3 P, uint Steps, float FootprintM = 0.0)
+{
+    if (!C.UseClouds || !C.UseCloudShadows || C.Coverage <= 0.001 || C.Extinction <= 0.001) return 0.0;
+    float Limit = min(180000.0, PlanetCloudGroundDistance(P, C.SunDirection, C.RadiusM));
+    float Tau = 0.0;
+    for (uint I = 0u; I < 3u; ++I)
+    {
+        PlanetaryCloudLayer L = PlanetCloudLayer(C, I);
+        float4 Spans = PlanetCloudLayerSpans(P, C.SunDirection, C.RadiusM, L, Limit);
+        Tau += CloudLightSpanTau(C, L, P, Spans.xy, Steps, FootprintM);
+        if (Tau < 18.0)
+            Tau += CloudLightSpanTau(C, L, P, Spans.zw, Steps, FootprintM);
+        if (Tau >= 18.0) break;
+    }
+    return min(18.0, Tau);
+}
+
+float CloudTransportHG(float Mu, float G)
+{
+    float G2 = G * G;
+    float T = max(1.0e-4, 1.0 + G2 - 2.0 * G * Mu);
+    return (1.0 - G2) / (4.0 * CloudTransportPi * T * sqrt(T));
+}
+
+float CloudDualLobe(float Mu, float G, float Scale)
+{
+    return 0.86 * CloudTransportHG(Mu, G * Scale) + 0.14 * CloudTransportHG(Mu, -0.25 * Scale);
+}
+
+float3 CloudScatteringOrderPhases(PlanetaryCloudConfig C, float3 D)
+{
+    float Mu = dot(D, C.SunDirection);
+    float G = clamp(C.PhaseG, 0.40, 0.92);
+    return float3(CloudDualLobe(Mu, G, 1.0), CloudDualLobe(Mu, G, 0.49), CloudDualLobe(Mu, G, 0.19));
+}
+
+float3 PlanetCloudSource(PlanetaryCloudConfig C, PlanetaryCloudLayer L, float3 P,
+                         float Sigma, float3 OrderPhases, float FootprintM)
+{
+    float3 Direct = C.SolarIrradiance * CloudSolarAirTransmittance(C, P);
+    float SunTau = 0.0;
+    if (dot(Direct, Direct) > 1.0e-6)
+        SunTau = CloudSolarOpticalDepth(C, P, C.LightSteps, FootprintM);
+    // Order weights sum to one. Each higher order relaxes anisotropy and
+    // optical depth; powder trades first-order energy into the diffuse orders.
+    float Powder = 1.0 - exp(-2.0 * min(6.0, Sigma * 110.0 + 0.28 * SunTau));
+    float3 Weight = lerp(float3(0.62, 0.24, 0.14), float3(0.45, 0.34, 0.21), Powder);
+    float DirectPhase = dot(Weight * OrderPhases, exp(-SunTau * float3(1.0, 0.41, 0.18)));
+
+    float H = saturate((PlanetCloudAltitude(P, C.RadiusM) - L.BottomM) / (L.TopM - L.BottomM));
+    float SunUp = dot(normalize(P), C.SunDirection);
+    float Day = smoothstep(-0.20, 0.23, SunUp);
+    float Warm = exp(-abs(SunUp - 0.045) * 9.5) * smoothstep(-0.20, -0.025, SunUp);
+    // At positive solar elevations the directional depth is also a useful
+    // local proxy for sky occlusion. Do not use it as a hemispheric estimate
+    // at twilight, where even a clear zenith has a long horizontal path.
+    float SkyVisibility = lerp(1.0, 0.40 + 0.60 * exp(-0.26 * SunTau), smoothstep(0.12, 0.50, SunUp));
+    float3 Sky = C.SkyAmbient * (0.064 + 0.48 * Day) * lerp(0.48, 1.0, H) * SkyVisibility;
+    float3 Bounce = (1.0 - H) * (float3(0.032, 0.048, 0.071) * Day + float3(0.077, 0.029, 0.015) * Warm);
+    return Direct * (1.16 * DirectPhase) + Sky + Bounce;
+}
+
+PlanetaryCloudResult TracePlanetaryClouds(PlanetaryCloudConfig C, float3 O, float3 D, float2 Pixel, float LimitM)
+{
+    PlanetaryCloudResult Result;
+    Result.Radiance = float3(0.0);
+    Result.Transmittance = 1.0;
+    Result.DistanceM = 0.0;
+    if (!C.UseClouds || C.Coverage <= 0.001 || C.Extinction <= 0.001) return Result;
+
+    float ViewAlt = PlanetCloudAltitude(O, C.RadiusM);
+    float NearSurface = 1.0 - smoothstep(9000.0, 49000.0, ViewAlt);
+    LimitM = min(LimitM, PlanetCloudGroundDistance(O, D, C.RadiusM));
+    if (NearSurface > 0.999) LimitM = min(LimitM, 105000.0);
+    PlanetaryCloudInterval Spans[6];
+    uint Count = 0u;
+    for (uint I = 0u; I < 3u; ++I)
+    {
+        PlanetaryCloudLayer L = PlanetCloudLayer(C, I);
+        float4 S = PlanetCloudLayerSpans(O, D, C.RadiusM, L, LimitM);
+        if (S.y > S.x)
+        {
+            Spans[Count].NearM = S.x; Spans[Count].FarM = S.y; Spans[Count++].Layer = I;
+        }
+        if (S.w > S.z)
+        {
+            Spans[Count].NearM = S.z; Spans[Count].FarM = S.w; Spans[Count++].Layer = I;
+        }
+    }
+    if (Count == 0u) return Result;
+    float Jitter = CloudBlueJitter(Pixel);
+    float3 OrderPhases = CloudScatteringOrderPhases(C, D);
+    for (uint I = 0u; I < Count && Result.Transmittance > 0.004; ++I)
+    {
+        // Selection sort over at most six closed, non-overlapping intervals.
+        uint First = I;
+        for (uint J = I + 1u; J < Count; ++J)
+            if (Spans[J].NearM < Spans[First].NearM) First = J;
+        PlanetaryCloudInterval Span = Spans[First];
+        Spans[First] = Spans[I];
+        PlanetaryCloudLayer L = PlanetCloudLayer(C, Span.Layer);
+        float MinStep = (L.Kind == 0u) ? 8.0 : (L.Kind == 1u ? 12.0 : 9.0);
+        float SpanLength = Span.FarM - Span.NearM;
+        float OrbitalFoot = 2350.0 * smoothstep(44000.0, 520000.0, ViewAlt);
+        float FlightLod = smoothstep(9000.0, 35000.0, ViewAlt);
+        float Travel = Span.NearM;
+        float WeatherStep = lerp(870.0, 4800.0, FlightLod);
+        float W0 = Travel;
+        float W1 = min(Travel + WeatherStep, Span.FarM);
+        CloudWeatherSample WNear = CloudWeatherAtPoint(C, O + D * W0, L.Kind);
+        CloudWeatherSample WFar = CloudWeatherAtPoint(C, O + D * W1, L.Kind);
+        bool HaveDensity = false;
+        // The view march is finer than the light march. Cache irradiance only
+        // across nearby occupied samples on this ray, never across frames.
+        float LitAt = -1.0e8;
+        float3 CachedSource = float3(0.0);
+        uint EmptySteps = 0u;
+        uint Budget = C.Steps * 3u;
+        // Reserve far samples with a growing step schedule. A uniform
+        // remaining-distance floor would force horizon-sized steps even at
+        // the camera in the middle of a long, nearly horizontal cloud ray.
+        float GrowthRate = exp(3.35 / float(Budget));
+        float RemainingGrowth = exp(3.35);
+        for (uint S = 0u; S < Budget && Travel < Span.FarM && Result.Transmittance > 0.004; ++S)
+        {
+            float Foot = max(OrbitalFoot, max(MinStep, Travel * C.PixelAngle));
+            float DistanceStep = MinStep + Travel * 0.0016;
+            float QualityStep = SpanLength / float(C.Steps * 2u);
+            float Fine = clamp(DistanceStep, MinStep, max(MinStep, QualityStep * 1.8));
+            Fine = lerp(Fine, max(MinStep, QualityStep * 3.0), FlightLod);
+            float GrowthFloor = (GrowthRate - 1.0) / max(GrowthRate - 1.0, RemainingGrowth - 1.0);
+            Fine = max(Fine, (Span.FarM - Travel) * ((S + 1u < Budget) ? GrowthFloor : 1.0));
+            RemainingGrowth /= GrowthRate;
+            float Coarse = min(Fine * (1.0 + min(2.0, float(EmptySteps) * 0.5)), max(Fine, 40.0 + Travel * 0.0037));
+            bool Probe = !HaveDensity && S + 1u < Budget && Coarse > Fine + 1.0;
+            float Dt = min(Span.FarM - Travel, Probe ? Coarse : Fine);
+            float U = 0.042 + 0.916 * frac(Jitter + float(S) * 0.618033989 + float(I) * 0.381966011);
+            float SampleT = Travel + U * Dt;
+            if (SampleT > W1)
+            {
+                W0 = W1;
+                W1 = min(Span.FarM, max(W1 + WeatherStep, SampleT + 0.25 * WeatherStep));
+                WNear = WFar;
+                WFar = CloudWeatherAtPoint(C, O + D * W1, L.Kind);
+            }
+            CloudWeatherSample W = LerpCloudWeather(WNear, WFar, saturate((SampleT - W0) / max(0.1, W1 - W0)));
+            if (max(WNear.Moisture, WFar.Moisture) <= 0.15)
+            {
+                Travel = W1;
+                continue;
+            }
+            float3 P = O + D * SampleT;
+            float Sigma = SamplePlanetCloudDensity(C, L, P, W, max(Foot, Dt * 0.24), Probe);
+            Sigma *= 1.0 - NearSurface * smoothstep(30000.0, 105000.0, SampleT);
+            if (Probe && Sigma > 1.0e-6)
+            {
+                HaveDensity = true;
+                EmptySteps = 0u;
+                continue;
+            }
+            if (Sigma > 1.0e-6)
+            {
+                float SegT = exp(-Sigma * Dt);
+                float Weight = Result.Transmittance * (1.0 - SegT);
+                float LightStride = clamp(34.0 + Travel * 0.0023, 34.0, 220.0);
+                if (SampleT - LitAt >= LightStride || !HaveDensity)
+                {
+                    CachedSource = PlanetCloudSource(C, L, P, Sigma, OrderPhases, max(Foot, Dt * 0.52));
+                    LitAt = SampleT;
+                }
+                Result.Radiance += Weight * CachedSource;
+                Result.DistanceM += Weight * SampleT;
+                Result.Transmittance *= SegT;
+                HaveDensity = true;
+                EmptySteps = 0u;
+            }
+            else
+            {
+                HaveDensity = false;
+                ++EmptySteps;
+            }
+            Travel += Dt;
+        }
+    }
+    Result.DistanceM /= max(1.0e-6, 1.0 - Result.Transmittance);
+    return Result;
+}
+
+#endif
